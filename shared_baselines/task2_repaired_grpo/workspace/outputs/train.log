[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{540}{s + 2} + t = 144 \quad \text{(4)}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m ---
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m ### Step 3: Solve the system of equations (2) and (4)
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m We have:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{540}{s} + t = 240 \quad \text{(2)}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{540}{s + 2} + t = 144 \quad \text{(4)}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Subtract (4) from (2):
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \left( \frac{540}{s} - \frac{540}{s + 2} \right) = 240 - 144 = 96
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Compute the difference:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{540}{s} - \frac{540}{s + 2} = 96
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Factor out 540:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 540 \left( \frac{1}{s} - \frac{1}{s + 2} \right) = 96
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Compute the difference inside the parentheses:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{1}{s} - \frac{1}{s + 2} = \frac{(s + 2) - s}{s(s + 2)} = \frac{2}{s(s + 2)}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m So:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 540 \cdot \frac{2}{s(s + 2)} = 96
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{1080}{s(s + 2)} = 96
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Multiply both sides by $ s(s + 2) $:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 1080 = 96s(s + 2)
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Divide both sides by 24:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 45 = 4s(s + 2)
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Expand the right-hand side:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 45 = 4s^2 + 8s
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Bring all terms to one side:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 4s^2 + 8s - 45 = 0
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Solve this quadratic equation using the quadratic formula:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m s = \frac{-8 \pm \sqrt{8^2 - 4 \cdot 4 \cdot (-45)}}{2 \cdot 4}
[36m(TaskRunner pid=25208)[0m = \frac{-8 \pm \sqrt{64 + 720}}{8}
[36m(TaskRunner pid=25208)[0m = \frac{-8 \pm \sqrt{784}}{8}
[36m(TaskRunner pid=25208)[0m = \frac{-8 \pm 28}{8}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m So:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m s = \frac{-8 + 28}{8} = \frac{20}{8} = 2.5 \quad \text{or} \quad s = \frac{-8 - 28}{8} = \frac{-36}{8} = -4.5
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Since speed cannot be negative, we take:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m s = 2.5 \text{ km/h}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m ---
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m ### Step 4: Find $ t $ using equation (2)
[36m(TaskRunner pid=25208)[0m 
