[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m So:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 96 = 540 \cdot \frac{2}{s(s + 2)}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 96 = \frac{1080}{s(s + 2)}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Solve for $ s(s + 2) $:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m s(s + 2) = \frac{1080}{96} = \frac{135}{12} = \frac{45}{4}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Now solve the quadratic:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
