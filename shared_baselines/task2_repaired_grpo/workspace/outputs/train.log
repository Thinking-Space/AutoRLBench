[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Multiply both sides by -1:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m \frac{18}{s(s + 2)} = 1.6
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Now solve for $ s $:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m s(s + 2) = \frac{18}{1.6} = 11.25
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m So:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
