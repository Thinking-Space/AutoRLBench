[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 9b + 7 \equiv 0 \pmod{b + 7}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Let’s perform the division:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 9b + 7 = q(b + 7) + r
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m We can write:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 9b + 7 = q(b + 7) + r
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Let’s divide $ 9b + 7 $ by $ b + 7 $:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
