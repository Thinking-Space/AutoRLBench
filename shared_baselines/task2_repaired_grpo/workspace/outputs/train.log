[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 9b + 7 \equiv 0 \pmod{b + 7}
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m Let’s rewrite the expression:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 9b + 7 = 9(b + 7) - 56
[36m(TaskRunner pid=25208)[0m $$
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m So:
[36m(TaskRunner pid=25208)[0m 
[36m(TaskRunner pid=25208)[0m $$
