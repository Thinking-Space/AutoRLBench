{
  "schema_version": 1,
  "command": "mkdir -p \"$AUTORLBENCH_RESULTS/experiment_logs\" && bash run_grpo.sh",
  "env": {
    "MODEL": "$AUTORLBENCH_WORKSPACE/models/Qwen3-1.7B",
    "TORCH_DIST": "$AUTORLBENCH_WORKSPACE/models/Qwen3-1.7B_torch_dist",
    "OUT": "$AUTORLBENCH_RESULTS/experiment_logs",
    "NGPU": "2",
    "NUM_ROLLOUT": "30",
    "RAY_AUTH_MODE": "disabled",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1"
  },
  "timeout_s": 21600,
  "log_roots": [
    "experiment_logs"
  ]
}
