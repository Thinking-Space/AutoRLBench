+#!/usr/bin/env python
+"""Comprehensive test script for colorlog features."""
+
+import colorlog
+import sys
+
+# Test basicConfig with default parameters
+print("Test 1: basicConfig with default parameters")
+colorlog.basicConfig()
+logger = colorlog.getLogger()
+logger.info("This should work with default parameters")
+
+# Test basicConfig with custom format
+print("\nTest 2: basicConfig with custom format")
+colorlog.basicConfig(
+    format="%(log_color)s[%(levelname)s] %(reset)s %(blue)s%(message)s",
+    datefmt="%Y-%m-%d %H:%M:%S"
+)
+logger.info("This should work with custom format")
+
+# Test basicConfig with log_colors
+print("\nTest 3: basicConfig with log_colors")
+colorlog.basicConfig(
+    log_colors={
+        'DEBUG': 'cyan',
+        'INFO': 'green',
+        'WARNING': 'yellow',
+        'ERROR': 'red',
+        'CRITICAL': 'red,bg_white',
+    }
+)
+logger.info("This should work with custom log_colors")
+
+# Test debug, info, warning, error, critical with decorator
+print("\nTest 4: Decorated functions (debug, info, warning, error, critical)")
+colorlog.debug("Debug message")
+colorlog.info("Info message")
+colorlog.warning("Warning message")
+colorlog.error("Error message")
+colorlog.critical("Critical message")
+
+# Test log function
+print("\nTest 5: log function")
+colorlog.log(colorlog.INFO, "Log with level INFO")
+
+print("\nAll tests passed!")
