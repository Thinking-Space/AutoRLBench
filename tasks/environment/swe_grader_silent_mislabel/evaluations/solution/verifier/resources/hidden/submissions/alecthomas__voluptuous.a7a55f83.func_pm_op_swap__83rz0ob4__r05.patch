+#!/usr/bin/env python
+"""Test script to reproduce the RequiredFieldInvalid error path order issue."""
+
+from voluptuous import Schema, Required, Invalid
+
+def test_nested_required_field_path():
+    # Create a nested schema with required fields
+    schema = Schema({
+        Required('user'): {
+            Required('profile'): {
+                Required('name'): str
+            }
+        }
+    })
+
+    # Try to validate incomplete data
+    try:
+        schema({'user': {'profile': {}}})
+    except Invalid as e:
+        print("Actual error path:", e.path)
+        print("Expected error path: ['user', 'profile', 'name']")
+        print("Path order is correct:", e.path == ['user', 'profile', 'name'])
+        return e.path
+
+if __name__ == '__main__':
+    test_nested_required_field_path()
