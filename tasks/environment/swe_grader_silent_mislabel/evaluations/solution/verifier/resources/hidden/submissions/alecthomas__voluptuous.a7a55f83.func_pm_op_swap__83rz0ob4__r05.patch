+#!/usr/bin/env python
+"""Script to fix the RequiredFieldInvalid error path order in nested schemas."""
+
+import re
+
+# Read the file
+with open('/testbed/voluptuous/schema_builder.py', 'r') as f:
+    content = f.read()
+
+# Replace the problematic line
+pattern = r'errors\.append\(er\.RequiredFieldInvalid\(msg,\[key\]\+path\)\)'
+replacement = 'errors.append(er.RequiredFieldInvalid(msg,path+[key]))'
+
+new_content = re.sub(pattern, replacement, content)
+
+# Write the file back
+with open('/testbed/voluptuous/schema_builder.py', 'w') as f:
+    f.write(new_content)
+
+print("File updated successfully")
