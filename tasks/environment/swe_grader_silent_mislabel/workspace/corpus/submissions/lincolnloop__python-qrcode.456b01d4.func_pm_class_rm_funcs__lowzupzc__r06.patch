+    def is_eye(self, row: int, col: int):
+        """
+        Find whether the referenced module is in an eye.
+        """
+        return (
+            (row < 7 and col < 7)
+            or (row < 7 and self.width - col < 8)
+            or (self.width - row < 8 and col < 7)
+        )
+
