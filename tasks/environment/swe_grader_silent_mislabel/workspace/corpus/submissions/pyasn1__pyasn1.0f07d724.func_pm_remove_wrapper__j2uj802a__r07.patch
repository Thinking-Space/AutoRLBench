+#!/usr/bin/env python3
+
+"""Test script to reproduce the Real infinity string handling issue."""
+
+from pyasn1.type import univ
+
+def test_real_infinity_strings():
+    print("Testing Real with string infinity values...")
+
+    # Test positive infinity
+    try:
+        real_inf = univ.Real('inf')
+        print(f"univ.Real('inf') = {real_inf}")
+        print(f"str(univ.Real('inf')) = {str(real_inf)}")
+        print(f"repr(univ.Real('inf')) = {repr(real_inf)}")
+    except Exception as e:
+        print(f"Error with 'inf': {e}")
+
+    # Test negative infinity
+    try:
+        real_neg_inf = univ.Real('-inf')
+        print(f"univ.Real('-inf') = {real_neg_inf}")
+        print(f"str(univ.Real('-inf')) = {str(real_neg_inf)}")
+        print(f"repr(univ.Real('-inf')) = {repr(real_neg_inf)}")
+    except Exception as e:
+        print(f"Error with '-inf': {e}")
+
+    # Test that regular float conversion works
+    try:
+        print(f"float('inf') = {float('inf')}")
+        print(f"float('-inf') = {float('-inf')}")
+    except Exception as e:
+        print(f"Error with float conversion: {e}")
+
+if __name__ == '__main__':
+    test_real_infinity_strings()
