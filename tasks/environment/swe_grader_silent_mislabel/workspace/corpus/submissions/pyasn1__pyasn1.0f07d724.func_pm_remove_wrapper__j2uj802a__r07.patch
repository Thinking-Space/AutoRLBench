+#!/usr/bin/env python3
+
+"""Test the exact examples from the PR description."""
+
+from pyasn1.type import univ
+
+def test_pr_examples():
+    print("Testing the exact examples from the PR description...")
+
+    # Test the examples from the PR
+    try:
+        real_inf = univ.Real('inf')
+        print(f"univ.Real('inf') = {real_inf}")
+        print(f"str(univ.Real('inf')) = {str(real_inf)}")
+        print(f"repr(univ.Real('inf')) = {repr(real_inf)}")
+        assert str(real_inf) == 'inf', f"Expected 'inf', got '{str(real_inf)}'"
+    except Exception as e:
+        print(f"Error: {e}")
+        raise
+
+    try:
+        real_neg_inf = univ.Real('-inf')
+        print(f"univ.Real('-inf') = {real_neg_inf}")
+        print(f"str(univ.Real('-inf')) = {str(real_neg_inf)}")
+        print(f"repr(univ.Real('-inf')) = {repr(real_neg_inf)}")
+        assert str(real_neg_inf) == '-inf', f"Expected '-inf', got '{str(real_neg_inf)}'"
+    except Exception as e:
+        print(f"Error: {e}")
+        raise
+
+    print("All PR examples work correctly!")
+
+if __name__ == '__main__':
+    test_pr_examples()
