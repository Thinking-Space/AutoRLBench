+    def is_eye(self, row: int, col: int) -> bool:
+        """
+        Check if the given position (row, col) is part of an eye (alignment pattern).
+
+        In QR codes, there are three alignment patterns (eyes) at the corners:
+        - Top-left: rows 0-6, columns 0-6 (7x7 squares)
+        - Top-right: rows 0-6, columns width-7 to width-1 (7x7 squares)
+        - Bottom-left: rows width-7 to width-1, columns 0-6 (7x7 squares)
+        """
+        width = self.width
+        # Check top-left eye (0-6, 0-6)
+        if row <= 6 and col <= 6:
+            return True
+        # Check top-right eye (0-6, width-7 to width-1)
+        if row <= 6 and col >= width - 7:
+            return True
+        # Check bottom-left eye (width-7 to width-1, 0-6)
+        if row >= width - 7 and col <= 6:
+            return True
+        return False
+
