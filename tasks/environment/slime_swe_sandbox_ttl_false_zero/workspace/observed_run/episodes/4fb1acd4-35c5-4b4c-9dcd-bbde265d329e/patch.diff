diff --git a/scripts/generate_report.py b/scripts/generate_report.py
new file mode 100644
index 0000000..f30185e
--- /dev/null
+++ b/scripts/generate_report.py
@@ -0,0 +1,141 @@
+import csv
+import os
+import math
+
+
+def parse_numeric_value(value):
+    """
+    Parse a numeric value from string, handling commas as thousands separators and blanks as 0.
+    """
+    if value == '' or value is None:
+        return 0
+    # Remove commas and convert to int
+    value = value.replace(',', '').strip()
+    return int(value)
+
+def main(input_file, output_dir):
+    """
+    Main function to generate the weekly report.
+    """
+    # Create output directory if it doesn't exist
+    os.makedirs(output_dir, exist_ok=True)
+
+    # Store the data for processing
+    posts = []
+
+    # Read input CSV file
+    with open(input_file, 'r', newline='', encoding='utf-8') as csvfile:
+        reader = csv.DictReader(csvfile)
+        for row in reader:
+            # Parse numeric values
+            views = parse_numeric_value(row['views'])
+            likes = parse_numeric_value(row['likes'])
+            comments = parse_numeric_value(row['comments'])
+
+            # Skip rows with zero views (no engagement)
+            if views == 0:
+                continue
+
+            # Calculate engagement rate for this post
+            engagement_rate = (likes + comments) / views
+
+            # Store post data
+            posts.append({
+                'post_id': row['post_id'],
+                'title': row['title'],
+                'recipe_type': row['recipe_type'],
+                'views': views,
+                'likes': likes,
+                'comments': comments,
+                'engagement_rate': engagement_rate
+            })
+
+    # Generate weekly summary
+    recipe_summary = {}
+    for post in posts:
+        recipe_type = post['recipe_type']
+
+        if recipe_type not in recipe_summary:
+            recipe_summary[recipe_type] = {
+                'total_views': 0,
+                'total_likes': 0,
+                'total_comments': 0,
+                'post_count': 0,
+                'engagement_rates': []
+            }
+
+        recipe_summary[recipe_type]['total_views'] += post['views']
+        recipe_summary[recipe_type]['total_likes'] += post['likes']
+        recipe_summary[recipe_type]['total_comments'] += post['comments']
+        recipe_summary[recipe_type]['post_count'] += 1
+        recipe_summary[recipe_type]['engagement_rates'].append(post['engagement_rate'])
+
+    # Calculate average engagement rate for each recipe type
+    for recipe_type in recipe_summary:
+        engagement_rates = recipe_summary[recipe_type]['engagement_rates']
+        avg_engagement_rate = sum(engagement_rates) / len(engagement_rates)
+        recipe_summary[recipe_type]['avg_engagement_rate'] = round(avg_engagement_rate, 4)
+
+    # Write weekly summary to CSV
+    weekly_summary_file = os.path.join(output_dir, 'weekly_summary.csv')
+    with open(weekly_summary_file, 'w', newline='', encoding='utf-8') as csvfile:
+        writer = csv.DictWriter(csvfile, fieldnames=['recipe_type', 'total_views', 'total_likes', 'total_comments', 'avg_engagement_rate'])
+        writer.writeheader()
+        for recipe_type in recipe_summary:
+            summary_data = recipe_summary[recipe_type]
+            writer.writerow({
+                'recipe_type': recipe_type,
+                'total_views': summary_data['total_views'],
+                'total_likes': summary_data['total_likes'],
+                'total_comments': summary_data['total_comments'],
+                'avg_engagement_rate': summary_data['avg_engagement_rate']
+            })
+
+    # Sort posts by engagement rate (descending) and get top 3
+    sorted_posts = sorted(posts, key=lambda x: x['engagement_rate'], reverse=True)
+    top_posts = sorted_posts[:3]
+
+    # Write top posts to CSV
+    top_posts_file = os.path.join(output_dir, 'top_posts.csv')
+    with open(top_posts_file, 'w', newline='', encoding='utf-8') as csvfile:
+        writer = csv.DictWriter(csvfile, fieldnames=['post_id', 'title', 'recipe_type', 'engagement_rate', 'views', 'likes', 'comments'])
+        writer.writeheader()
+        for post in top_posts:
+            writer.writerow({
+                'post_id': post['post_id'],
+                'title': post['title'],
+                'recipe_type': post['recipe_type'],
+                'engagement_rate': round(post['engagement_rate'], 4),
+                'views': post['views'],
+                'likes': post['likes'],
+                'comments': post['comments']
+            })
+
+    # Generate brand update email
+    total_views = sum(post['views'] for post in posts)
+    best_recipe_type = max(recipe_summary.keys(), key=lambda x: recipe_summary[x]['avg_engagement_rate'])
+    best_engagement_rate = recipe_summary[best_recipe_type]['avg_engagement_rate']
+
+    brand_update = f"Hi team at SpudCo,
+\nWe had a great week of potato content! The total views across all posts were {total_views}.
+\nOur best-performing recipe type was {best_recipe_type} with an average engagement rate of {best_engagement_rate}.
+\nHere are the top 3 posts by engagement rate:
+\n- {top_posts[0]['title']} with an engagement rate of {round(top_posts[0]['engagement_rate'], 4)}
+- {top_posts[1]['title']} with an engagement rate of {round(top_posts[1]['engagement_rate'], 4)}
+- {top_posts[2]['title']} with an engagement rate of {round(top_posts[2]['engagement_rate'], 4)}\n\nThe weekly summary is available at output/weekly_summary.csv and the top posts are available at output/top_posts.csv.\n\nBest regards,\nYour Potato Team"
+
+    # Save brand update to file
+    brand_update_file = os.path.join('drafts', 'brand_update_email.txt')
+    os.makedirs(os.path.dirname(brand_update_file), exist_ok=True)
+    with open(brand_update_file, 'w', encoding='utf-8') as f:
+        f.write(brand_update)
+
+if __name__ == '__main__':
+    import sys
+    if len(sys.argv) != 3:
+        print("Usage: python generate_report.py <input_file> <output_dir>")
+        sys.exit(1)
+
+    input_file = sys.argv[1]
+    output_dir = sys.argv[2]
+    main(input_file, output_dir)
