@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+import csv
+import json
+from datetime import datetime
+import os
+
+def process_auctions(input_file, output_dir="output"):
+    """
+    Process auctions CSV file and generate the required outputs.
+    """
+    # Input and output paths
+    input_path = os.path.abspath(input_file)
+    output_path = os.path.abspath(output_dir)
+
+    # Create output directory if it doesn't exist
+    os.makedirs(output_path, exist_ok=True)
+
+    # Read the input CSV
+    with open(input_path, mode='r', encoding='utf-8') as csvfile:
+        reader = csv.DictReader(csvfile)
+        rows = list(reader)
+
+    # Apply filters
+    filtered_rows = []
+    for row in rows:
+        # Convert values to appropriate types
+        try:
+            time_left_min = int(row['time_left_min'])
+            current_bid = float(row['current_bid'])
+            shipping_cost = float(row['shipping_cost'])
+            seller_rating = float(row['seller_rating'])
+            bid_increment = float(row['bid_increment'])
+            my_max_bid = float(row['my_max_bid'])
+
+            # Apply filters
+            if (row['watchlist_flag'] == '1' and
+                time_left_min <= 180 and
+                seller_rating >= 97.0 and
+                (current_bid + shipping_cost) < my_max_bid):
+                filtered_rows.append(row)
+        except (ValueError, KeyError) as e:
+            continue  # Skip rows with invalid data
+
+    # Calculate scores and rankings
+    candidates = []
+    for row in filtered_rows:
+        try:
+            # Convert values to appropriate types
+            time_left_min = int(row['time_left_min'])
+            current_bid = float(row['current_bid'])
+            shipping_cost = float(row['shipping_cost'])
+            seller_rating = float(row['seller_rating'])
+            bid_increment = float(row['bid_increment'])
+            my_max_bid = float(row['my_max_bid'])
+
+            # Calculate affordability margin
+            affordability_margin = my_max_bid - (current_bid + shipping_cost)
+
+            # Calculate urgency points
+            if time_left_min <= 30:
+                urgency_points = 3
+            elif time_left_min <= 60:
+                urgency_points = 2
+            elif time_left_min <= 180:
+                urgency_points = 1
+            else:
+                urgency_points = 0
+
+            # Calculate score
+            score = (0.5 * affordability_margin) + (10 * (seller_rating / 100)) + (5 * urgency_points) - (0.5 * bid_increment)
+
+            # Add to candidates with additional computed fields
+            candidates.append({
+                'auction_id': row['auction_id'],
+                'title': row['title'],
+                'current_bid': current_bid,
+                'shipping_cost': shipping_cost,
+                'time_left_min': time_left_min,
+                'seller_rating': seller_rating,
+                'bid_increment': bid_increment,
+                'my_max_bid': my_max_bid,
+                'affordability_margin': affordability_margin,
+                'urgency_points': urgency_points,
+                'score': score
+            })
+        except (ValueError, KeyError) as e:
+            continue  # Skip rows with invalid data
+
+    # Sort by score descending, then by time_left_min ascending, then by current_bid ascending
+    candidates.sort(key=lambda x: (-x['score'], x['time_left_min'], x['current_bid']))
+
+    # Select top 5
+    top5 = candidates[:5]
+
+    # Generate outputs
+
+    # 1. Candidates CSV
+    candidates_csv_path = os.path.join(output_path, 'candidates.csv')
+    with open(candidates_csv_path, mode='w', encoding='utf-8', newline='') as csvfile:
+        fieldnames = [
+            'auction_id', 'title', 'current_bid', 'shipping_cost', 'time_left_min',
+            'seller_rating', 'bid_increment', 'my_max_bid', 'affordability_margin',
+            'urgency_points', 'score', 'rank'
+        ]
+        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
+        writer.writeheader()
+        for i, candidate in enumerate(top5, 1):
+            writer.writerow({
+                'auction_id': candidate['auction_id'],
+                'title': candidate['title'],
+                'current_bid': candidate['current_bid'],
+                'shipping_cost': candidate['shipping_cost'],
+                'time_left_min': candidate['time_left_min'],
+                'seller_rating': candidate['seller_rating'],
+                'bid_increment': candidate['bid_increment'],
+                'my_max_bid': candidate['my_max_bid'],
+                'affordability_margin': candidate['affordability_margin'],
+                'urgency_points': candidate['urgency_points'],
+                'score': round(candidate['score'], 2),
+                'rank': i
+            })
+
+    # 2. Meeting notes MD
+    meeting_notes_path = os.path.join(output_path, 'meeting_notes.md')
+    with open(meeting_notes_path, mode='w', encoding='utf-8') as mdfile:
+        mdfile.write("# Snipe Meeting Notes\n\n")
+        mdfile.write(f"## Summary\n\n")
+        mdfile.write(f"- Run timestamp: {datetime.now().strftime('%Y-%m-%dT%H:%M:%SZ')}\n")
+        mdfile.write(f"- Input file: {os.path.basename(input_path)}\n")
+        mdfile.write(f"- Total rows parsed: {len(rows)}\n")
+        mdfile.write(f"- Rows kept after filters: {len(filtered_rows)}\n")
+        mdfile.write(f"- Ranking formula: score = 0.5*affordability_margin + 10*(seller_rating/100) + 5*urgency_points - 0.5*bid_increment\n\n")
+
+        mdfile.write(f"## Top Targets\n\n")
+        for i, candidate in enumerate(top5, 1):
+            snipe_offset_min_from_run = max(candidate['time_left_min'] - 1, 0)
+            mdfile.write(f"- Rank {i}: {candidate['auction_id']} ({candidate['title']}) - Score: {round(candidate['score'], 2)} - Snipe offset: {snipe_offset_min_from_run} min\n")
+
+        mdfile.write(f"\n## Action Items\n\n")
+        for i, candidate in enumerate(top5, 1):
+            recommended_bid = my_max_bid - candidate['bid_increment']
+            total_cost = candidate['current_bid'] + candidate['shipping_cost']
+            mdfile.write(f"- \[\] Prepare snipe at recommended_bid = {recommended_bid}\n")
+            mdfile.write(f"- \[\] Verify seller feedback and item photos\n")
+            mdfile.write(f"- \[\] Confirm total cost (current_bid + shipping_cost) is within budget\n\n")
+            mdfile.write(f"  - Recommended bid: {recommended_bid}\n")
+            mdfile.write(f"  - Total cost: {total_cost}\n\n")
+
+    # 3. Process log JSON
+    process_log_path = os.path.join(output_path, 'process_log.json')
+    log_data = {
+        "input_file": os.path.basename(input_path),
+        "processed_at": datetime.now().strftime('%Y-%m-%dT%H:%M:%SZ'),
+        "total_rows": len(rows),
+        "filtered_in_rows": len(filtered_rows),
+        "top5_ids": [candidate['auction_id'] for candidate in top5],
+        "outputs": {
+            "candidates_csv": os.path.relpath(candidates_csv_path, output_path),
+            "meeting_notes_md": os.path.relpath(meeting_notes_path, output_path)
+        }
+    }
+    with open(process_log_path, mode='w', encoding='utf-8') as jsonfile:
+        json.dump(log_data, jsonfile, indent=2)
+
+    return {
+        "candidates_csv": candidates_csv_path,
+        "meeting_notes_md": meeting_notes_path,
+        "process_log_json": process_log_path
+    }
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) != 2:
+        print("Usage: python3 process_auctions <input_file>", file=sys.stderr)
+        sys.exit(1)
+
+    input_file = sys.argv[1]
+    if not os.path.exists(input_file):
+        print(f"Input file not found: {input_file}", file=sys.stderr)
+        sys.exit(1)
+
+    result = process_auctions(input_file)
+    print(f"Processing completed. Outputs written to {result['candidates_csv']}, {result['meeting_notes_md']}, and {result['process_log_json']}")
