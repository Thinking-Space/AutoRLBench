+import csv
+import json
+import os
+from collections import defaultdict
+
+def load_config(path="config/newsletter_config.json"):
+    with open(path, "r", encoding="utf-8") as f:
+        return json.load(f)
+
+def read_rows(csv_path="input/data/constituent_contacts.csv"):
+    rows = []
+    with open(csv_path, newline="", encoding="utf-8") as f:
+        reader = csv.DictReader(f)
+        for r in reader:
+            rows.append(r)
+    return rows
+
+def ensure_dir(path):
+    d = os.path.dirname(path)
+    if d and not os.path.exists(d):
+        os.makedirs(d, exist_ok=True)
+
+def month_key(datestr):
+    # Expecting YYYY-MM-DD
+    return datestr[:7]
+
+def main():
+    cfg = load_config()
+    rows = read_rows()
+
+    # Filter by region if configured
+    region = cfg.get("region_filter", "All")
+    if region and region != "All":
+        rows = [r for r in rows if r.get("region") == region]
+
+    # Initialize data collections
+    monthly_counts = defaultdict(int)
+    channel_counts = defaultdict(lambda: defaultdict(int))
+    zip_counts = defaultdict(lambda: defaultdict(int))
+
+    # Process each row to collect data
+    for r in rows:
+        m = month_key(r.get("date", ""))
+        if m:
+            monthly_counts[m] += 1
+
+            # Track opposition to policy changes
+            stance = r.get("stance", "")
+            if stance == "oppose_change":
+                monthly_counts[m] += 1  # This would be wrong - need to separate oppose_contacts
+
+            # Track channel data
+            channel = r.get("channel", "")
+            if channel:
+                channel_counts[channel][m] += 1
+                channel_counts[channel]["total_contacts"] += 1
+                if stance == "oppose_change":
+                    channel_counts[channel]["oppose_contacts"] += 1
+
+            # Track ZIP code data
+            zip_code = r.get("zip", "")
+            if zip_code:
+                zip_counts[zip_code][m] += 1
+                zip_counts[zip_code]["total_contacts"] += 1
+                if stance == "oppose_change":
+                    zip_counts[zip_code]["oppose_contacts"] += 1
+
+    # Generate monthly summary
+    out_summary = cfg.get("summary_path", "output/middle_east_summary.csv")
+    ensure_dir(out_summary)
+    with open(out_summary, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["month", "total_contacts", "oppose_contacts", "oppose_pct"])
+        for m in sorted(monthly_counts.keys()):
+            total_contacts = monthly_counts[m]
+            oppose_contacts = 0
+            # We need to recalculate oppose_contacts from the raw data
+            # Let's fix this by reprocessing the data more accurately
+
+    # Fix: We need to process the data in a different way to correctly count oppose_contacts
+    # Let's completely restructure the data processing
+
+    # Collect all data first
+    monthly_data = []
+    channel_data = []
+    zip_data = []
+
+    for r in rows:
+        m = month_key(r.get("date", ""))
+        if m:
+            stance = r.get("stance", "")
+            if stance == "oppose_change":
+                oppose = True
+            else:
+                oppose = False
+
+            monthly_data.append({
+                "month": m,
+                "total_contacts": 1,
+                "oppose_contacts": 1 if oppose else 0,
+                "oppose_pct": 0.0
+            })
+
+            channel = r.get("channel", "")
+            if channel:
+                channel_data.append({
+                    "channel": channel,
+                    "total_contacts": 1,
+                    "oppose_contacts": 1 if oppose else 0,
+                    "oppose_pct": 0.0
+                })
+
+            zip_code = r.get("zip", "")
+            if zip_code:
+                zip_data.append({
+                    "zip": zip_code,
+                    "total_contacts": 1,
+                    "oppose_contacts": 1 if oppose else 0,
+                    "oppose_pct": 0.0
+                })
+
+    # Fix: We need to count correctly - let's process each row again
+    monthly_data = []
+    channel_data = []
+    zip_data = []
+
+    for r in rows:
+        m = month_key(r.get("date", ""))
+        if m:
+            stance = r.get("stance", "")
+            oppose = (stance == "oppose_change")
+
+            monthly_data.append({
+                "month": m,
+                "total_contacts": 1,
+                "oppose_contacts": 1 if oppose else 0,
+                "oppose_pct": 0.0
+            })
+
+            channel = r.get("channel", "")
+            if channel:
+                channel_data.append({
+                    "channel": channel,
+                    "total_contacts": 1,
+                    "oppose_contacts": 1 if oppose else 0,
+                    "oppose_pct": 0.0
+                })
+
+            zip_code = r.get("zip", "")
+            if zip_code:
+                zip_data.append({
+                    "zip": zip_code,
+                    "total_contacts": 1,
+                    "oppose_contacts": 1 if oppose else 0,
+                    "oppose_pct": 0.0
+                })
+
+    # Now we need to aggregate the data correctly
+    monthly_counts = defaultdict(int)
+    monthly_oppose_counts = defaultdict(int)
+    channel_counts = defaultdict(lambda: defaultdict(int))
+    channel_oppose_counts = defaultdict(lambda: defaultdict(int))
+    zip_counts = defaultdict(lambda: defaultdict(int))
+    zip_oppose_counts = defaultdict(lambda: defaultdict(int))
+
+    for r in rows:
+        m = month_key(r.get("date", ""))
+        if m:
+            stance = r.get("stance", "")
+            oppose = (stance == "oppose_change")
+
+            monthly_counts[m] += 1
+            monthly_oppose_counts[m] += 1 if oppose else 0
+
+            channel = r.get("channel", "")
+            if channel:
+                channel_counts[channel][m] += 1
+                channel_oppose_counts[channel][m] += 1 if oppose else 0
+
+            zip_code = r.get("zip", "")
+            if zip_code:
+                zip_counts[zip_code][m] += 1
+                zip_oppose_counts[zip_code][m] += 1 if oppose else 0
+
+    # Generate monthly summary
+    out_summary = cfg.get("summary_path", "output/middle_east_summary.csv")
+    ensure_dir(out_summary)
+    with open(out_summary, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["month", "total_contacts", "oppose_contacts", "oppose_pct"])
+        for m in sorted(monthly_counts.keys()):
+            total_contacts = monthly_counts[m]
+            oppose_contacts = monthly_oppose_counts[m]
+            oppose_pct = round(oppose_contacts / total_contacts * 100, 2) if total_contacts > 0 else 0.0
+            w.writerow([m, total_contacts, oppose_contacts, oppose_pct])
+
+    # Generate channel breakdown
+    out_channel = cfg.get("channel_path", "output/middle_east_by_channel.csv")
+    ensure_dir(out_channel)
+    with open(out_channel, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["channel", "total_contacts", "oppose_contacts", "oppose_pct"])
+        # Group by channel and sum up
+        for channel in channel_counts.keys():
+            total_contacts = sum(channel_counts[channel].values())
+            oppose_contacts = sum(channel_oppose_counts[channel].values())
+            oppose_pct = round(oppose_contacts / total_contacts * 100, 2) if total_contacts > 0 else 0.0
+            w.writerow([channel, total_contacts, oppose_contacts, oppose_pct])
+
+    # Generate top ZIP codes
+    out_zip = cfg.get("zip_path", "output/middle_east_top_zips.csv")
+    ensure_dir(out_zip)
+    with open(out_zip, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["zip", "total_contacts", "oppose_contacts", "oppose_pct"])
+        # Group by ZIP code and sum up
+        for zip_code in zip_counts.keys():
+            total_contacts = sum(zip_counts[zip_code].values())
+            oppose_contacts = sum(zip_oppose_counts[zip_code].values())
+            oppose_pct = round(oppose_contacts / total_contacts * 100, 2) if total_contacts > 0 else 0.0
+            w.writerow([zip_code, total_contacts, oppose_contacts, oppose_pct])
+
+    # Write config snapshot
+    snapshot = {
+        "region_filter": cfg.get("region_filter"),
+        "policy_position": cfg.get("policy_position")
+    }
+    out_snapshot = "output/config_snapshot.json"
+    ensure_dir(out_snapshot)
+    with open(out_snapshot, "w", newline="", encoding="utf-8") as f:
+        json.dump(snapshot, f, indent=2)
+
+if __name__ == "__main__":
+    main()
