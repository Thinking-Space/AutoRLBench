--- /dev/null
+++ b/scripts/process_orders_refactored.py
@@ -0,0 +1,134 @@
+"""
+Refactored order total calculator that uses state-based surcharge rates.
+
+This script eliminates hardcoded surcharge values and reads per-state surcharge rates
+from data/shipping_rates.json. It also reads processing_fee from config/app.json
+and handles missing/blank customer_state by falling back to the config's default_state.
+"""
+
+import csv
+import json
+import os
+
+
+def calc_total(subtotal: float, customer_state: str, processing_fee: float, surcharge_rate: float) -> float:
+    """
+    Compute total by applying the state-based surcharge and processing fee.
+
+    Args:
+        subtotal: The base order subtotal
+        customer_state: The customer's state (used to lookup surcharge rate)
+        processing_fee: The processing fee (read from config)
+        surcharge_rate: The state-specific surcharge rate (read from shipping rates)
+
+    Returns:
+        The computed total rounded to 2 decimal places
+    """
+    return round(subtotal + subtotal * surcharge_rate + processing_fee, 2)
+
+
+def main() -> None:
+    # Read configuration
+    with open('config/app.json', 'r', encoding='utf-8') as f:
+        cfg = json.load(f)
+
+    # Update config values
+    default_state = cfg.get('default_state', 'VIC')
+    processing_fee = cfg.get('processing_fee', 1.5)
+
+    # Paths
+    in_path = 'data/orders.csv'
+    out_dir = cfg.get('output_dir', 'output')
+    os.makedirs(out_dir, exist_ok=True)
+
+    # Read shipping rates
+    with open('data/shipping_rates.json', 'r', encoding='utf-8') as f:
+        shipping_rates = json.load(f)
+
+    # Output paths
+    out_path_refactored = os.path.join(out_dir, 'totals_refactored.csv')
+    out_path_comparison = os.path.join(out_dir, 'totals_comparison.csv')
+
+    # Write refactored totals
+    with open(out_path_refactored, 'w', encoding='utf-8', newline='') as outfile:
+        fieldnames = ['order_id', 'customer_state', 'subtotal', 'surcharge_rate', 'processing_fee', 'total']
+        writer = csv.DictWriter(outfile, fieldnames=fieldnames)
+        writer.writeheader()
+
+        with open(in_path, 'r', encoding='utf-8', newline='') as infile:
+            reader = csv.DictReader(infile)
+            for row in reader:
+                try:
+                    subtotal = float(row.get('subtotal', '0'))
+                except ValueError:
+                    continue
+
+                customer_state = row.get('customer_state', '').strip()
+
+                # Handle missing/blank customer_state by falling back to default_state
+                if not customer_state:
+                    customer_state = default_state
+
+                # Look up surcharge rate
+                surcharge_rate = shipping_rates.get(customer_state, 0.0)
+
+                # Calculate total
+                total = calc_total(subtotal, customer_state, processing_fee, surcharge_rate)
+
+                # Write to CSV
+                writer.writerow({
+                    'order_id': row.get('order_id', ''),
+                    'customer_state': customer_state,
+                    'subtotal': f"{subtotal:.2f}",
+                    'surcharge_rate': f"{surcharge_rate:.2f}",
+                    'processing_fee': f"{processing_fee:.2f}",
+                    'total': f"{total:.2f}"
+                })
+
+    # Write comparison totals
+    with open(out_path_comparison, 'w', encoding='utf-8', newline='') as outfile:
+        fieldnames = ['order_id', 'customer_state', 'subtotal', 'total_old', 'total_refactored', 'delta']
+        writer = csv.DictWriter(outfile, fieldnames=fieldnames)
+        writer.writeheader()
+
+        with open(in_path, 'r', encoding='utf-8', newline='') as infile:
+            reader = csv.DictReader(infile)
+            for row in reader:
+                try:
+                    subtotal = float(row.get('subtotal', '0'))
+                except ValueError:
+                    continue
+
+                customer_state = row.get('customer_state', '').strip()
+
+                # Handle missing/blank customer_state by falling back to default_state
+                if not customer_state:
+                    customer_state = default_state
+
+                # Calculate old total (flat 8% surcharge and $1.50 fee)
+                old_surcharge_rate = 0.08
+                old_total = calc_total(subtotal, customer_state, processing_fee, old_surcharge_rate)
+
+                # Calculate refactored total
+                shipping_rates_file = open('data/shipping_rates.json', 'r', encoding='utf-8')
+                shipping_rates_data = json.load(shipping_rates_file)
+                shipping_rates_file.close()
+
+                surcharge_rate = shipping_rates_data.get(customer_state, 0.0)
+                refactored_total = calc_total(subtotal, customer_state, processing_fee, surcharge_rate)
+
+                # Calculate delta
+                delta = refactored_total - old_total
+
+                # Write to CSV
+                writer.writerow({
+                    'order_id': row.get('order_id', ''),
+                    'customer_state': customer_state,
+                    'subtotal': f"{subtotal:.2f}",
+                    'total_old': f"{old_total:.2f}",
+                    'total_refactored': f"{refactored_total:.2f}",
+                    'delta': f"{delta:.2f}"
+                })
+
+if __name__ == '__main__':
+    main()
