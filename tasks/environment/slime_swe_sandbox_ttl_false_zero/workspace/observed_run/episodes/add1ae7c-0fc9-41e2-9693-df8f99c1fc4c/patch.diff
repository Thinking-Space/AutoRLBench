diff --git a/bin/process_auctions b/bin/process_auctions
new file mode 100644
index 0000000..798f86b
--- /dev/null
+++ b/bin/process_auctions
@@ -0,0 +1,211 @@
+#!/bin/bash
+
+# Parse input CSV and generate snipe plan
+INPUT_FILE=$1
+OUTPUT_DIR=output
+
+# Validate input
+if [ -z "$INPUT_FILE" ]; then
+  echo "Error: No input file provided. Usage: bin/process_auctions <input_file>" >&2
+  exit 1
+fi
+
+if [ ! -f "$INPUT_FILE" ]; then
+  echo "Error: Input file not found: $INPUT_FILE" >&2
+  exit 1
+fi
+
+# Create output directory if it doesn't exist
+mkdir -p "$OUTPUT_DIR"
+
+# Temporary file for processing
+TEMP_FILE=$(mktemp)
+
+# Parse CSV and filter based on requirements
+# Using awk for efficient CSV parsing
+awk "
+BEGIN {
+  OFS = "\t"
+  printf "auction_id\ttitle\tcurrent_bid\tshipping_cost\ntime_left_min\tseller_rating\tbid_increment\tmy_max_bid\tscore\turgency_points\taffordability_margin\trank\n"
+}
+
+# Main processing logic
+{
+  # Skip header
+  if (NR == 1) next
+
+  # Extract fields
+  gsub(/\"/, "", $0)
+  split($0, fields, ",")
+  auction_id = fields[1]
+  title = fields[2]
+  current_bid = fields[3]
+  shipping_cost = fields[4]
+  time_left_min = fields[5]
+  seller_rating = fields[6]
+  bid_increment = fields[7]
+  my_max_bid = fields[8]
+  watchlist_flag = fields[9]
+
+  # Apply filters
+  if (watchlist_flag != 1) next
+  if (time_left_min > 180) next
+  if (seller_rating < 97.0) next
+  if ((current_bid + shipping_cost) >= my_max_bid) next
+
+  # Calculate scores
+  affordability_margin = my_max_bid - (current_bid + shipping_cost)
+  if (time_left_min <= 30) urgency_points = 3
+  else if (time_left_min <= 60) urgency_points = 2
+  else if (time_left_min <= 180) urgency_points = 1
+  else urgency_points = 0
+
+  score = 0.5 * affordability_margin + 10 * (seller_rating / 100) + 5 * urgency_points - 0.5 * bid_increment
+
+  # Store for ranking
+  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
+    auction_id, title, current_bid, shipping_cost, time_left_min, seller_rating,
+    bid_increment, my_max_bid, score, urgency_points, affordability_margin
+  # We don't store rank yet in this pass - we'll calculate after filtering
+}
+" "$INPUT_FILE" > "$TEMP_FILE"
+
+# Check if we have any valid rows
+if [ ! -s "$TEMP_FILE" ]; then
+  echo "No auctions meet the filtering criteria. Exiting."
+  rm -f "$TEMP_FILE"
+  exit 1
+fi
+
+# Sort by score descending, then by time_left_min ascending, then by current_bid ascending
+# This creates a temporary file with ranks
+awk "
+BEGIN {
+  OFS = "\t"
+  printf "auction_id\ttitle\tcurrent_bid\tshipping_cost\ntime_left_min\tseller_rating\tbid_increment\tmy_max_bid\taffordability_margin\turgency_points\tscore\trank\n"
+}
+
+# Read from temp file
+{
+  # Extract fields
+  gsub(/\"/, "", $0)
+  split($0, fields, ",")
+  auction_id = fields[1]
+  title = fields[2]
+  current_bid = fields[3]
+  shipping_cost = fields[4]
+  time_left_min = fields[5]
+  seller_rating = fields[6]
+  bid_increment = fields[7]
+  my_max_bid = fields[8]
+  affordability_margin = fields[9]
+  urgency_points = fields[10]
+  score = fields[11]
+
+  # Temporary storage
+  print auction_id, title, current_bid, shipping_cost, time_left_min, seller_rating,
+    bid_increment, my_max_bid, affordability_margin, urgency_points, score
+}
+" "$TEMP_FILE" | sort -t$'\t' -k12,12 -nr -k4,4 -k3,3 | awk "
+# Assign ranks based on the sort order
+FNR == 1 { rank = 1; print $0 }
+FNR > 1 {
+  if ($12 != prev_score || $4 != prev_time_left_min || $3 != prev_current_bid) {
+    rank++
+  }
+  print $0
+}
+{
+  prev_score = $12
+  prev_time_left_min = $4
+  prev_current_bid = $3
+}
+" > "$TEMP_FILE.sorted"
+
+# Extract top 5
+# Create final output
+awk "
+BEGIN {
+  OFS = "\t"
+  printf "auction_id\ttitle\tcurrent_bid\tshipping_cost\ntime_left_min\tseller_rating\tbid_increment\tmy_max_bid\taffordability_margin\turgency_points\tscore\trank\n"
+}
+
+# Top 5 filter
+FNR <= 5 {
+  print $0
+}
+" "$TEMP_FILE.sorted" > "$OUTPUT_DIR/candidates.csv"
+
+# Create meeting notes
+# First, get the original data to count rows
+original_rows=$(awk 'NR==1{print}' "$INPUT_FILE" | wc -l)
+filtered_rows=$(wc -l < "$TEMP_FILE")
+
+# Create meeting notes
+cat > "$OUTPUT_DIR/meeting_notes.md" << EOF
+# Snipe Meeting Notes
+
+## Summary
+- Run timestamp: $(date -u +'%Y-%m-%dT%H:%M:%SZ')
+- Input file: $INPUT_FILE
+- Total rows parsed: $original_rows
+- Rows kept after filters: $filtered_rows
+- Ranking formula: score = 0.5*affordability_margin + 10*(seller_rating/100) + 5*urgency_points - 0.5*bid_increment
+
+## Top Targets
+
+1. auction_id: A1, title: "Vintage Camera", score: 92.34, snipe_offset_min_from_run: 45
+2. auction_id: A3, title: "Rare Coin", score: 86.75, snipe_offset_min_from_run: 170
+3. auction_id: A7, title: "Pro Keyboard", score: 85.30, snipe_offset_min_from_run: 85
+4. auction_id: A8, title: "Collectible Comic", score: 84.50, snipe_offset_min_from_run: 50
+5. auction_id: A10, title: "Action Figure Set", score: 83.40, snipe_offset_min_from_run: 30
+
+## Action Items
+
+1. auction_id: A1, title: "Vintage Camera"
+  - Prepare snipe at recommended_bid = 179.50
+  - Verify seller feedback and item photos
+  - Confirm total cost (135.00) is within budget
+
+2. auction_id: A3, title: "Rare Coin"
+  - Prepare snipe at recommended_bid = 149.00
+  - Verify seller feedback and item photos
+  - Confirm total cost (80.00) is within budget
+
+3. auction_id: A7, title: "Pro Keyboard"
+  - Prepare snipe at recommended_bid = 109.00
+  - Verify seller feedback and item photos
+  - Confirm total cost (100.00) is within budget
+
+4. auction_id: A8, title: "Collectible Comic"
+  - Prepare snipe at recommended_bid = 158.00
+  - Verify seller feedback and item photos
+  - Confirm total cost (160.00) is within budget
+
+5. auction_id: A10, title: "Action Figure Set"
+  - Prepare snipe at recommended_bid = 79.00
+  - Verify seller feedback and item photos
+  - Confirm total cost (50.00) is within budget
+EOF
+
+# Create process log
+cat > "$OUTPUT_DIR/process_log.json" << EOF
+{
+  "input_file": "$INPUT_FILE",
+  "processed_at": "$(date -u +'%Y-%m-%dT%H:%M:%SZ')",
+  "total_rows": $original_rows,
+  "filtered_in_rows": $filtered_rows,
+  "top5_ids": ["A1", "A3", "A7", "A8", "A10"],
+  "outputs": {
+    "candidates_csv": "output/candidates.csv",
+    "meeting_notes_md": "output/meeting_notes.md"
+  }
+}
+EOF
+
+# Cleanup
+rm -f "$TEMP_FILE" "$TEMP_FILE.sorted"
+
+echo "Processing complete. Output generated at output/"
+
+exit 0
