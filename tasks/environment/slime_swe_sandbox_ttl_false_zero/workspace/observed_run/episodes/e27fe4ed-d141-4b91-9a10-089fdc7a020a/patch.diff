+Resolved the issue by updating the configuration file and modifying the report script to generate reports on opposition to policy changes in the Middle East. The changes included:
+
+1. Updated config/newsletter_config.json with:
+   - region_filter set to "Middle East"
+   - policy_position set to "No policy changes in the Middle East"
+   - output paths set to the required paths
+
+2. Modified scripts/report_script.py to:
+   - Filter records by the Middle East region
+   - Generate monthly summary with oppose_contacts and oppose_pct
+   - Create channel breakdown sorted by total_contacts descending
+   - Generate top 3 ZIP codes report sorted by total_contacts descending
+   - Write config snapshot to output/config_snapshot.json
+
+All required deliverables are now ready to be generated when the script runs.
\ No newline at end of file
diff --git a/scripts/report_script.py b/scripts/report_script.py
new file mode 100644
index 0000000..83f6613
--- /dev/null
+++ b/scripts/report_script.py
@@ -0,0 +1,105 @@
+import csv
+import json
+import os
+from collections import defaultdict
+
+def load_config(path="config/newsletter_config.json"):
+    with open(path, "r", encoding="utf-8") as f:
+        return json.load(f)
+
+def read_rows(csv_path="input/data/constituent_contacts.csv"):
+    rows = []
+    with open(csv_path, newline="", encoding="utf-8") as f:
+        reader = csv.DictReader(f)
+        for r in reader:
+            rows.append(r)
+    return rows
+
+def ensure_dir(path):
+    d = os.path.dirname(path)
+    if d and not os.path.exists(d):
+        os.makedirs(d, exist_ok=True)
+
+def month_key(datestr):
+    # Expecting YYYY-MM-DD
+    return datestr[:7]
+
+def main():
+    cfg = load_config()
+    rows = read_rows()
+
+    # Filter by region if configured
+    region = cfg.get("region_filter", "All")
+    if region and region != "All":
+        rows = [r for r in rows if r.get("region") == region]
+
+    # Generate monthly summary
+    monthly_counts = defaultdict(int)
+    channel_counts = defaultdict(lambda: defaultdict(int))  # channel -> {total, oppose}
+    zip_counts = defaultdict(lambda: defaultdict(int))       # zip -> {total, oppose}
+
+    for r in rows:
+        m = month_key(r.get("date", ""))
+        if m:
+            monthly_counts[m] += 1
+
+        # Track channel and ZIP data
+        channel = r.get("channel", "")
+        zip_code = r.get("zip", "")
+        stance = r.get("stance", "")
+
+        if stance == "oppose_change":
+            # Count as opposed
+            channel_counts[channel]["oppose"] += 1
+            zip_counts[zip_code]["oppose"] += 1
+
+        # Track total contacts for all channels and ZIPs
+        channel_counts[channel]["total"] += 1
+        zip_counts[zip_code]["total"] += 1
+
+    # Write monthly summary
+    out_summary = cfg.get("summary_path", "output/middle_east_summary.csv")
+    ensure_dir(out_summary)
+    with open(out_summary, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["month", "total_contacts", "oppose_contacts", "oppose_pct"])
+        for m in sorted(monthly_counts.keys()):
+            total = monthly_counts[m]
+            oppose = channel_counts[m]["oppose"] if m in channel_counts else 0
+            oppose_pct = round((oppose / total) * 100, 2) if total > 0 else 0
+            w.writerow([m, total, oppose, oppose_pct])
+
+    # Write channel breakdown
+    out_channel = cfg.get("channel_path", "output/middle_east_by_channel.csv")
+    ensure_dir(out_channel)
+    with open(out_channel, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["channel", "total_contacts", "oppose_contacts", "oppose_pct"])
+        for channel in sorted(channel_counts.keys(), key=lambda c: channel_counts[c]["total"], reverse=True):
+            total = channel_counts[channel]["total"]
+            oppose = channel_counts[channel]["oppose"]
+            oppose_pct = round((oppose / total) * 100, 2) if total > 0 else 0
+            w.writerow([channel, total, oppose, oppose_pct])
+
+    # Write top 3 ZIP codes
+    out_zip = cfg.get("zip_path", "output/middle_east_top_zips.csv")
+    ensure_dir(out_zip)
+    with open(out_zip, "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["zip", "total_contacts", "oppose_contacts", "oppose_pct"])
+        # Sort by total_contacts descending, then by zip ascending
+        sorted_zips = sorted(zip_counts.items(), key=lambda x: (-x[1]["total"], int(x[0])))
+        # Take only top 3
+        for zip_code, data in sorted_zips[:3]:
+            total = data["total"]
+            oppose = data["oppose"]
+            oppose_pct = round((oppose / total) * 100, 2) if total > 0 else 0
+            w.writerow([zip_code, total, oppose, oppose_pct])
+
+    # Write config snapshot
+    snapshot = {"region_filter": cfg.get("region_filter"), "policy_position": cfg.get("policy_position")}
+    with open("output/config_snapshot.json", "w", encoding="utf-8") as f:
+        json.dump(snapshot, f, indent=2)
+
+if __name__ == "__main__":
+    main()
