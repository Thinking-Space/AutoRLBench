+#!/bin/bash
+#
+# Validation script to verify the output reports and data integrity
+#
+# This script performs the following checks:
+# 1. Verifies that the adjusted budget and summary reports exist
+# 2. Checks that the adjusted budget has the expected header columns
+# 3. Verifies that there is one data row per property in the adjusted budget
+# 4. Recomputes totals/min/max from the adjusted budget and compares them to the summary report
+# 5. Returns a non-zero exit code on any mismatch
+#
+# Usage: ./scripts/validate_output.sh
+#
+# Note: This script assumes the reports are generated by the run_pipeline.sh script
+
+set -euo pipefail
+
+# Define the paths to the reports
+adjusted_budget_path="reports/adjusted_budget.csv"
+summary_path="reports/summary.csv"
+
+# Check if the adjusted budget report exists
+if [ ! -f "$adjusted_budget_path" ]; then
+  echo "Error: reports/adjusted_budget.csv not found"
+  exit 1
+fi
+
+# Check if the summary report exists
+if [ ! -f "$summary_path" ]; then
+  echo "Error: reports/summary.csv not found"
+  exit 1
+fi
+
+# Read the expected schema from input/expected_report_schema.json
+expected_schema_path="input/expected_report_schema.json"
+if [ ! -f "$expected_schema_path" ]; then
+  echo "Error: input/expected_report_schema.json not found"
+  exit 1
+fi
+
+# Extract the expected columns from the schema
+# We'll use jq to parse the JSON and extract the column names
+# The expected columns are in the adjusted_budget_columns array
+
+# Check that the adjusted budget has the expected header columns
+# First, check if the file has the expected header
+# We'll use head -n 1 to get the first line (header)
+head -n 1 "$adjusted_budget_path" | grep -q "property_id,property_name,city,base_monthly_budget_usd,yoy_inflation_rate,inflation_adjusted_monthly_budget_usd"
+
+if [ $? -ne 0 ]; then
+  echo "Error: Adjusted budget header does not match expected schema"
+  exit 1
+fi
+
+# Check that there is one data row per property
+# Count the number of rows in the adjusted budget
+adjusted_rows=$(wc -l < "$adjusted_budget_path")
+# Subtract 1 for the header row
+data_rows=$((adjusted_rows - 1))
+
+# Count the number of properties from the input budget
+input_budget_path="input/maintenance_budget.csv"
+input_properties=$(wc -l < "$input_budget_path")
+# Subtract 1 for the header row
+input_data_rows=$((input_properties - 1))
+
+if [ $data_rows -ne $input_data_rows ]; then
+  echo "Error: Number of data rows in adjusted budget ($data_rows) does not match input budget ($input_data_rows)"
+  exit 1
+fi
+
+# Recompute totals/min/max from the adjusted budget and compare to summary
+# Extract the totals from the adjusted budget
+adjusted_totals=$(awk -F',' '{sum += $6} END {print sum}' reports/adjusted_budget.csv)
+adjusted_min=$(awk -F',' '{min=($6 < min) ? $6 : min} END {print min}' reports/adjusted_budget.csv)
+adjusted_max=$(awk -F',' '{max=($6 > max) ? $6 : max} END {print max}' reports/adjusted_budget.csv)
+
+# Extract from the summary report
+summary_totals=$(awk -F',' '{sum += $3} END {print sum}' reports/summary.csv)
+summary_min=$(awk -F',' '{min=($6 < min) ? $6 : min} END {print min}' reports/summary.csv)
+summary_max=$(awk -F',' '{max=($6 > max) ? $6 : max} END {print max}' reports/summary.csv)
+
+# Compare the totals
+if [ "$(echo "$adjusted_totals $summary_totals" | awk '{print $1 > $2}')" != "1" ]; then
+  echo "Error: Total adjusted budget does not match between reports"
+  exit 1
+fi
+
+# Compare the min values
+if [ "$(echo "$adjusted_min $summary_min" | awk '{print $1 > $2}')" != "1" ]; then
+  echo "Error: Minimum adjusted budget does not match between reports"
+  exit 1
+fi
+
+# Compare the max values
+if [ "$(echo "$adjusted_max $summary_max" | awk '{print $1 > $2}')" != "1" ]; then
+  echo "Error: Maximum adjusted budget does not match between reports"
+  exit 1
+fi
+
+# Compare the yoy inflation rates
+# Extract from adjusted budget
+adjusted_yoy=$(awk -F',' '{print $5}' reports/adjusted_budget.csv | head -n1)
+# Extract from summary
+summary_yoy=$(awk -F',' '{print $4}' reports/summary.csv | head -n1)
+
+if [ "$(echo "$adjusted_yoy $summary_yoy" | awk '{print $1 > $2}')" != "1" ]; then
+  echo "Error: Year-over-year inflation rate does not match between reports"
+  exit 1
+fi
+
+# Compare the number of properties
+# Extract from adjusted budget
+adjusted_num=$(awk -F',' '{print $1}' reports/adjusted_budget.csv | head -n1)
+# Extract from summary
+summary_num=$(awk -F',' '{print $2}' reports/summary.csv | head -n1)
+
+if [ "$(echo "$adjusted_num $summary_num" | awk '{print $1 > $2}')" != "1" ]; then
+  echo "Error: Number of properties does not match between reports"
+  exit 1
+fi
+
+# Compare the total base budget
+# Extract from adjusted budget
+adjusted_base_total=$(awk -F',' '{sum += $4} END {print sum}' reports/adjusted_budget.csv)
+# Extract from summary
+summary_base_total=$(awk -F',' '{sum += $3} END {print sum}' reports/summary.csv)
+
+if [ "$(echo "$adjusted_base_total $summary_base_total" | awk '{print $1 > $2}')" != "1" ]; then
+  echo "Error: Total base budget does not match between reports"
+  exit 1
+fi
+
+# All checks passed
+echo "Validation completed successfully"
+exit 0
