+#!/bin/bash
+#
+# One-shot runner to execute the full pipeline immediately
+#
+# This script runs the complete pipeline: downloading CPI data, processing the budget, and generating reports
+#
+# Usage: ./scripts/run_once.sh
+#
+# Note: This script is useful for testing without waiting for the monthly schedule
+
+set -euo pipefail
+
+# Create necessary directories
+mkdir -p reports logs data/raw
+
+# Run the main pipeline script
+echo "Running pipeline..."
+./scripts/run_pipeline.sh
+
+# Verify the reports were created
+if [ -f "reports/adjusted_budget.csv" ] && [ -f "reports/summary.csv" ] && [ -f "logs/last_run.log" ]; then
+  echo "Pipeline completed successfully"
+  echo "Reports generated at: reports/adjusted_budget.csv and reports/summary.csv"
+  echo "Log file: logs/last_run.log"
+else
+  echo "Error: Reports not generated as expected"
+  exit 1
+fi
+
+# Run the validation script to confirm everything is correct
+echo "Running validation..."
+./scripts/validate_output.sh
+
+# If validation passes, confirm success
+if [ $? -eq 0 ]; then
+  echo "Validation completed successfully"
+else
+  echo "Validation failed! Please check the output files and data for errors."
+  exit 1
+fi
+
+# Final confirmation
+echo "Monthly inflation-adjusted maintenance budget report has been successfully generated and validated."
