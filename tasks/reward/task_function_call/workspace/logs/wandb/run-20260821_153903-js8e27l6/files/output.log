[code] def maxNumberOfBalloons(text: str) -> int:
    # Convert text to a set for faster lookup
    text_set = set(text)
    # Define the required characters for "balloon"
    required_chars = {'b', 'a', 'l', 'o', 'n', 'g'}

    # Count the occurrences of each required character
    count = {char: text_set.count(char) for char in required_chars}

    # Calculate the minimum occurrences of each character needed for "balloon"
    for char in count:
        if char == 'l' or char == 'o':
