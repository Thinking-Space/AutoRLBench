def has_solution(A, M):
    p = isqrt(M) + 1
    p2 = p * p

    # Check if A can be represented as A = p^2 * k mod M for some integer k
    # This is equivalent to checking if A is a quadratic residue modulo M
    return pow(A, (M + 1) // 4, M) == 1

