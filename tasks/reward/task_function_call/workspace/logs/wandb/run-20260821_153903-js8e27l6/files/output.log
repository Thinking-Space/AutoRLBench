[code] def is_prime(num):
    if num <= 1:
        return False
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            return False
    return True

def prime_sum(n):
    prime_sum = 0
    for num in range(1, n + 1):
        if is_prime(num):
