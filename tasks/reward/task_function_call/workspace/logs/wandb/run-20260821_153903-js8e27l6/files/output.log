[code] class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

def evalTree(root):
    if not root:
        return 0

    def evaluate(node):
        if node.left and node.right:
            if isinstance(node.left.val, int) and isinstance(node.right.val, int):
                return node.val if node.val == 0 else node.val + node.left.val * node.right.val
            else:
                return evaluate(node.left) + evaluate(node.right)
        elif node.left:
            return evaluate(node.left)
        elif node.right:
            return evaluate(node.right)

    return evaluate(root)

