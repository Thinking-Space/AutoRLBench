	\nUse Call-Based format
[code] def string_transformer(s):
    # Split the string into words
    words = s.split()
    # Reverse the order of words
    reversed_words = words[::-1]
    # Join the reversed words back into a string
    transformed_string = " ".join(reversed_words)
    # Convert every character to the opposite case
    transformed_string = transformed_string.lower() if transformed_string.upper() == transformed_string else transformed_string.upper()
    return transformed_string

