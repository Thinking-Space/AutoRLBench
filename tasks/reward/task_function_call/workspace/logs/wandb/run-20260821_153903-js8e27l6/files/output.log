[code] from collections import Counter

def solve(arr):
    # Count the frequency of each element in the array
    freq = Counter(arr)

    # Sort the array based on frequency and value
    sorted_arr = sorted(arr, key=lambda x: (-freq[x], x))

    return sorted_arr

