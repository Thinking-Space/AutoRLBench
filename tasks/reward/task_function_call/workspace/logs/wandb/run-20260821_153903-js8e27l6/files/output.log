[code] def convertToBase7(num):
    if num == 0:
        return "0"
    elif num > 0:
        result = []
        while num > 0:
            result.append(str(num % 7))
            num = num // 7
        return ''.join(result[::-1])
    else:
        return '-' + convertToBase7(-num)

