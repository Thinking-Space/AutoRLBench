[code] def convertToRoman(n):
    roman_numerals = {
        1000: 'M',
        900: 'CM',
        500: 'D',
        400: 'CD',
        100: 'C',
        90: 'XC',
        50: 'L',
        40: 'XL',
        10: 'X',
        9: 'IX',
        5: 'V',
        4: 'IV',
        1: 'I'
    }

    roman = ''
    for value in roman_numerals.keys():
        while n >= value:
            roman += roman_numerals[value]
            n -= value
    return roman

