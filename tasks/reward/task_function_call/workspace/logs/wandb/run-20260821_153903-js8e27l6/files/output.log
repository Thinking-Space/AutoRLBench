from itertools import permutations

def is_perfect_square(x):
    s = isqrt(x)
    return s * s == x

def find_good_permutation(n):
    for perm in permutations(range(n)):
        if all(is_perfect_square(a + i) for a, i in zip(perm, range(n))):
