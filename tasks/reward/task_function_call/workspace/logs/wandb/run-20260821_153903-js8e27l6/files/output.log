[code] def freq_seq(s, sep):
    count_dict = {}
    result = ""

    for char in s:
        if char in count_dict:
            count_dict[char] += 1
        else:
            count_dict[char] = 1

    for char, freq in count_dict.items():
        result += str(freq) + char

    return result.replace(".", sep)

