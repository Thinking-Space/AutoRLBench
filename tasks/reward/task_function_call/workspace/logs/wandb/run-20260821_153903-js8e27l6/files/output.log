def min_value_after_operations(N, K):
    # Function to calculate the minimum possible value
    def min_value(m):
        return max(1, (N + m - 1 - (N // m) * m))

    # Calculate the optimal value K up to which m can be incremented
    optimal_m = int(math.ceil(-3 / (2 * N * 2 ** 257 - 4)))
