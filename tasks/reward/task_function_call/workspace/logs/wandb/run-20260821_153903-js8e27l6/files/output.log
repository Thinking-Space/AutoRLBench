``` def reverse_words(text):
	\nUse Call-Based format
[code] def reverse_words(text):
    # Split the text into words, maintaining spaces
    words_with_spaces = text.split()

    # Reverse each word and join back with spaces
    reversed_words = [word[::-1] if word.isspace() else word for word in words_with_spaces]

    # Join the reversed words with spaces
    reversed_text = ' '.join(reversed_words)

    return reversed_text

# Test the function
print(reverse_words("This is an example!"))
print(reverse_words("double  spaces"))

