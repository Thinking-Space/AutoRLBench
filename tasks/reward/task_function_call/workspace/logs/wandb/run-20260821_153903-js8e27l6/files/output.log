[code] # Geeks has a pattern he wants to build
n = 5

# Function to print the pattern
def printTriangle(n):
    for i in range(n):
        # Print spaces
        for j in range(n - i - 1):
            print(" ", end="")
        # Print stars
        for j in range(2 * i + 1):
            print("*", end="")
        print()

