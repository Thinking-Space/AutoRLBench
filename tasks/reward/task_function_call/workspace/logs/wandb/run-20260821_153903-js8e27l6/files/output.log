[code] class Solution:
    def NthTerm (self, N):
        # Special cases
        if N == 1:
            return 2
        elif N == 2:
            return 2
        # General case
        return self.NthTerm(N // 2) * 2 if N % 2 == 0 else self.NthTerm((N - 1) // 2) * 2 + 2

