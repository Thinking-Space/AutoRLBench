[code] import math

def is_prime(num):
    if num > 1:
        for i in range(2, int(math.sqrt(num)) + 1):
            if (num % i) == 0:
                return False
        return True
    else:
        return False

def circular_prime(n):
    digits = str(n)
    length = len(digits)
    for i in range(length):
        # Rotate the number and check if it's prime
