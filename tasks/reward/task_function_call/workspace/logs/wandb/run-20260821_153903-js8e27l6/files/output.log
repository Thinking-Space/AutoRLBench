[code] def cube_odd(arr):
    sum_odd_cubed = 0
    for num in arr:
        if not isinstance(num, (int, float)):
            return None
        if num % 2 != 0:
            sum_odd_cubed += num ** 3
    return sum_odd_cubed

# Example usage:
