[code] def capitals_first(text):
    # Split the input text into words
    words = text.split()
    # Separate uppercase and lowercase words
    uppercase_words = [word for word in words if word.isupper()]
    lowercase_words = [word for word in words if word.islower()]

    # Combine the uppercase and lowercase words
    result = ' '.join(uppercase_words + lowercase_words)

    return result

