1 <= N <= 10^{6} #User function Template for python3





class Solution:

    ##Complete...[+165 chars]
[code] def max_consecutive_ones(N):
    # Convert the number to its binary representation
    binary_representation = bin(N)[2:]

    max_length = 0
    current_length = 0

    for bit in binary_representation:
        if bit == '1':
            current_length += 1
            max_length = max(max_length, current_length)
        else:
            current_length = 0

    return max_length

# Example usage
