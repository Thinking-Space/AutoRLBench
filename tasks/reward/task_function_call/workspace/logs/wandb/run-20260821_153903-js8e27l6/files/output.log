[code] import re

def numericals(s):
    pattern = re.compile(r'([^A-Za-z0-9])')
    result = ''
    count = 1
    for m in re.finditer(pattern, s):
        result += '1' + str(count)
        count = 1
        result += m.group(1)
    else:
        result += '1' + str(count)
    return result

