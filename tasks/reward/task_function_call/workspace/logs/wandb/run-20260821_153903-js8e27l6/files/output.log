[code] def cog_RPM(cogs, n):
    # Sort the cogs array to process from the outermost to the innermost cog
    cogs.sort(reverse=True)

    # Calculate the RPM of the outermost cog (first element)
    outermost_rpm = cogs[0]

    # Calculate the RPM of the innermost cog (last element)
    innermost_rpm = cogs[-1]

    return [outermost_rpm, innermost_rpm]

