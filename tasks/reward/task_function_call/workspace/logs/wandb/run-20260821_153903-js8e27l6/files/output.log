[code] def search_substr(full_text, search_text, allow_overlap=True):
    count = 0
    search_text = search_text.strip()
    if not search_text:
        return 0
    for i in range(len(full_text) - len(search_text) + 1):
        if full_text[i:i+len(search_text)] == search_text:
            count += 1
            if not allow_overlap and i != 0 and i+len(search_text) == len(full_text):
                break
    return count

