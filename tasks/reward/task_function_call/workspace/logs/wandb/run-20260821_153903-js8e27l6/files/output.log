[code] def find(arr, n, x):
    first_occurrence = second_occurrence = -1

    low = 0
    high = n - 1

    while low <= high:
        mid = (low + high) // 2

        if arr[mid] == x:
            first_occurrence = mid
            high = mid - 1

        elif arr[mid] < x:
            low = mid + 1

        else:
            high = mid - 1

    if first_occurrence != -1 and first_occurrence < second_occurrence:
        second_occurrence = mid

    return first_occurrence, second_occurrence

