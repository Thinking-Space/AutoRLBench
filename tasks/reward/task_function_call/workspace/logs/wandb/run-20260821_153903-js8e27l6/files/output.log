[code] def ones_complement(binary_number):
    # Convert the binary number to an integer
    binary_number = int(binary_number, 2)

    # Swap all 0s to 1s and all 1s to 0s
    ones_complement = ~binary_number

    # Convert the result back to a binary string
    ones_complement = bin(ones_complement)[2:]

    return ones_complement

