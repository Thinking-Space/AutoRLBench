1 <= N <= 10000 #User function Template for python3

class Solution:
	def sophie_Pr...[+51 chars]
[code] def is_prime(num):
    if num <= 1:
        return False
    if num == 2:
        return True
    if num % 2 == 0:
        return False
    for i in range(3, int(num**0.5) + 1, 2):
        if num % i == 0:
            return False
    return True

def generate_sophie_primes(n):
    sophie_primes = []
    for i in range(2, n):
        if is_prime(i) and is_prime(2*i + 1):
            sophie_primes.append(i)
    return sophie_primes

# Example usage
n = 5
print(generate_sophie_primes(n))  # Output: [2, 3]

n = 3
print(generate_sophie_primes(n))  # Output: [2]


