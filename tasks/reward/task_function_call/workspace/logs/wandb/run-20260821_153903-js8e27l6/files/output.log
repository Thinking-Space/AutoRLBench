[code] import math

def generate(numRows):
    triangle = []
    for i in range(numRows):
        row = []
        for j in range(i+1):
            if j == 0 or j == i:
                row.append(1)
            else:
                row.append(triangle[i-1][j-1] + triangle[i-1][j])
        triangle.append(row)
    return triangle

numRows = 5
