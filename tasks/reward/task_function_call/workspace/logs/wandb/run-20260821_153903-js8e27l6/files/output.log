[code] class Solution:
    def largestPalindrome(self, n: int) -> int:
        if n <= 13:
            return 999**2 % 1337
        elif n <= 31:
            return 998**2 % 1337
        else:
            for i in range(998, 99, -1):
                if str(i**2)[n-1:] == str(i**2)[-n:]:
                    return i**2 % 1337

