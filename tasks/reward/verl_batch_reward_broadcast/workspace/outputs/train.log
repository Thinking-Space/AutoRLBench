[36m(TaskRunner pid=13765)[0m Compute the discriminant:
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 2856^2 + 4 \cdot 12 \cdot 5130 = 8155136 + 248160 = 8403296
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m \sqrt{8403296} \approx 2900
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So:
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
