[36m(TaskRunner pid=13765)[0m \Rightarrow q^2 = \frac{120}{6 - 5m^2}
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So:
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m BD^2 = 4 \cdot \frac{120}{6 - 5m^2} \cdot (1 + m^2)
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
