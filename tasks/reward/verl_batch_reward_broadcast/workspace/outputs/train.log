[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So:
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m BD^2 = \frac{4}{\frac{3x - 5}{60}} \cdot (x + 1) = \frac{240}{3x - 5} \cdot (x + 1)
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So:
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m BD^2 = \frac{240(x + 1)}{3x - 5}
[36m(TaskRunner pid=13765)[0m $$
