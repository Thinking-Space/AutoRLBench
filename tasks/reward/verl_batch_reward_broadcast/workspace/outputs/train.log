[36m(TaskRunner pid=13765)[0m ### Step 6: Use the identity $IA^2 + OI^2 = AO^2$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m In general, for any triangle:
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m IA^2 + OI^2 = AO^2
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m This is a known identity in triangle geometry.
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So:
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m IA^2 + OI^2 = AO^2
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m We are given:
[36m(TaskRunner pid=13765)[0m - $OI = \sqrt{13}$
[36m(TaskRunner pid=13765)[0m - $IA \perp OI$, so $IA^2 + OI^2 = AO^2$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m But we are not given $AO$.
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m However, we can use the identity:
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m AO^2 = R^2 = 13^2 = 169
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So:
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m IA^2 + OI^2 = 169
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m We already found $OI = \sqrt{13}$, so:
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m IA^2 = 169 - 13 = 156
[36m(TaskRunner pid=13765)[0m \Rightarrow IA = \sqrt{156}
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m ---
