[36m(TaskRunner pid=13765)[0m So,
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m BD^2 = 9(1 + 2(u - 1)) = 9(1 + 2u - 2) = 9(2u - 1)
[36m(TaskRunner pid=13765)[0m $$
