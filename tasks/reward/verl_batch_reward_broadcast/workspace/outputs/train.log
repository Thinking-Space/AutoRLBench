[36m(TaskRunner pid=13765)[0m - $ \vec{AC} = (-a, -b) - (a, b) = (-2a, -2b) $
[36m(TaskRunner pid=13765)[0m - $ \vec{BD} = (-c, -d) - (c, d) = (-2c, -2d) $
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m So the vectors are $ \vec{AC} = (-2a, -2b) $, $ \vec{BD} = (-2c, -2d) $
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m Their dot product is:
[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
