[36m(TaskRunner pid=13765)[0m - $ B = (c, d) \Rightarrow \frac{c^2}{20} - \frac{d^2}{24} = 1 $
[36m(TaskRunner pid=13765)[0m - $ C = (-a, -b) \Rightarrow \frac{a^2}{20} - \frac{b^2}{24} = 1 $
[36m(TaskRunner pid=13765)[0m - $ D = (-c, -d) \Rightarrow \frac{c^2}{20} - \frac{d^2}{24} = 1 $
