[36m(TaskRunner pid=13765)[0m 
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m BD^2 = (-q - q)^2 + (-mq - mq)^2 = (-2q)^2 + (-2mq)^2 = 4q^2 + 4m^2 q^2 = 4q^2(1 + m^2)
[36m(TaskRunner pid=13765)[0m $$
[36m(TaskRunner pid=13765)[0m 
