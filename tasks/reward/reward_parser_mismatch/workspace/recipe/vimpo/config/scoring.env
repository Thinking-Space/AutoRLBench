# Scoring selection for the smoke-budget lane (SMOKE_SCORING=1 in run_main.sh).
#
# The 5-step smoke keeps the search_r1-style QA-contract scorer
# (math_reward.py) so on-policy scores stay comparable with the offline QA
# pipeline that produced the staged parquets. Full-budget runs keep the
# vimpo_trainer.yaml default (gurumath_qa_em.py) instead.
REWARD_OVERRIDE="reward.custom_reward_function.path=${PROJECT_ROOT}/autorlbench_case/math_reward.py reward.custom_reward_function.name=compute_score"
