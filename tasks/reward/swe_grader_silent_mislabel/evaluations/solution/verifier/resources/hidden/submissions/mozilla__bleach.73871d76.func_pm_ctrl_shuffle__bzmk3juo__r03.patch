+#!/usr/bin/env python
+"""Test script to reproduce the UnboundLocalError in target_blank callback."""
+
+import bleach
+from bleach.callbacks import target_blank
+
+# Test case 1: Empty attrs (should work but currently crashes)
+print("Test 1: Empty attrs")
+try:
+    attrs = {}
+    result = target_blank(attrs)
+    print("Result: {}".format(result))
+except Exception as e:
+    print("Error: {}: {}".format(type(e).__name__, e))
+
+# Test case 2: Attrs without href (should work but currently crashes)
+print("\nTest 2: Attrs without href")
+try:
+    attrs = {"_text": "somethingsomething"}
+    result = target_blank(attrs)
+    print("Result: {}".format(result))
+except Exception as e:
+    print("Error: {}: {}".format(type(e).__name__, e))
+
+# Test case 3: Attrs with href (should work)
+print("\nTest 3: Attrs with href")
+try:
+    attrs = {(None, "href"): "http://example.com"}
+    result = target_blank(attrs)
+    print("Result: {}".format(result))
+except Exception as e:
+    print("Error: {}: {}".format(type(e).__name__, e))
