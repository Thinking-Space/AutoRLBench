+#!/usr/bin/env python
+"""Fix the callbacks.py file to resolve UnboundLocalError in target_blank and fix rel_values join."""
+
+with open('/testbed/bleach/callbacks.py', 'r') as f:
+    content = f.read()
+
+# Fix the target_blank function - reorder lines to define href_key first
+lines = content.split('\n')
+
+# Find the target_blank function
+for i, line in enumerate(lines):
+    if 'deftarget_blank(attrs,new=False):' in line:
+        # Reorder the lines within the function
+        # Move href_key definition to the beginning
+        new_lines = []
+        j = i
+        while j < len(lines) and not (lines[j].strip() and not lines[j].startswith('def') and 'target_blank' not in lines[j]):
+            new_lines.append(lines[j])
+            j += 1
+
+        # Reorder the target_blank function
+        # 1. Define href_key=(None,"href") at the beginning
+        # 2. Check if href_key is not in attrs, return attrs
+        # 3. Check if attrs[href_key] starts with "mailto:", return attrs
+        # 4. Add target="_blank" to attrs
+        # 5. Return attrs
+
+        # Find the end of the function (next def or end of file)
+        func_end = j
+        while func_end < len(lines) and not lines[func_end].strip().startswith('def'):
+            func_end += 1
+
+        # Reorder the function content
+        func_lines = lines[i:func_end]
+        reordered_func_lines = []
+
+        # Find href_key definition
+        href_line_index = None
+        for idx, func_line in enumerate(func_lines):
+            if 'href_key=(None,"href")' in func_line:
+                href_line_index = idx
+                break
+
+        # Find the check for href_key not in attrs
+        check_line_index = None
+        for idx, func_line in enumerate(func_lines):
+            if 'ifhref_keynotinattrs:' in func_line:
+                check_line_index = idx
+                break
+
+        # Find the mailto check
+        mailto_line_index = None
+        for idx, func_line in enumerate(func_lines):
+            if 'ifattrs[href_key].startswith("mailto:"):' in func_line:
+                mailto_line_index = idx
+                break
+
+        # Find the target="_blank" assignment
+        target_line_index = None
+        for idx, func_line in enumerate(func_lines):
+            if 'attrs[(None,"target")]="_blank"' in func_line:
+                target_line_index = idx
+                break
+
+        # Reorder: href_key definition, check not in attrs, mailto check, target assignment, return
+        if href_line_index is not None:
+            reordered_func_lines.append(func_lines[href_line_index])
+        if check_line_index is not None:
+            reordered_func_lines.append(func_lines[check_line_index])
+        if mailto_line_index is not None:
+            reordered_func_lines.append(func_lines[mailto_line_index])
+        if target_line_index is not None:
+            reordered_func_lines.append(func_lines[target_line_index])
+        # Find the return statement
+        for idx, func_line in enumerate(func_lines):
+            if 'returnattrs' in func_line and idx not in [href_line_index, check_line_index, mailto_line_index, target_line_index]:
+                reordered_func_lines.append(func_line)
+                break
+
+        # Replace the function
+        lines[i:func_end] = reordered_func_lines
+        break
+
+# Fix the rel_values join - replace ""join with " ".join
+for i, line in enumerate(lines):
+    if 'attrs[rel_key]=""join(rel_values)' in line:
+        lines[i] = line.replace('""join(rel_values)', '" ".join(rel_values)')
+        break
+
+# Write the fixed content back
+with open('/testbed/bleach/callbacks.py', 'w') as f:
+    f.write('\n'.join(lines))
+
+print("Fixed callbacks.py")
