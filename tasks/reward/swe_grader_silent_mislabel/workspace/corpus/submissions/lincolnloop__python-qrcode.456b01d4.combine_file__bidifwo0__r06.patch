+#!/usr/bin/env python
+"""Test script to reproduce the PyPNGImage.save issue."""
+
+import qrcode
+from qrcode.image.pure import PyPNGImage
+import io
+
+# Create a QR code
+qr = qrcode.QRCode()
+qr.add_data("HelloWorld")
+img = qr.make_image(image_factory=PyPNGImage)
+
+# Try to save to a BytesIO stream
+print("Testing save to BytesIO stream...")
+try:
+    stream = io.BytesIO()
+    img.save(stream)
+    print("Success: Saved to BytesIO stream")
+except Exception as e:
+    print(f"Error: {type(e).__name__}: {e}")
+
+# Try to save to a file
+print("\nTesting save to file...")
+try:
+    img.save('test_qr.png')
+    print("Success: Saved to file")
+except Exception as e:
+    print(f"Error: {type(e).__name__}: {e}")
