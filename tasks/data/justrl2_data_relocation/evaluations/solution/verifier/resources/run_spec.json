{
  "schema_version": 1,
  "command": "mkdir -p \"$AUTORLBENCH_RESULTS/experiment_logs\" && python3 \"$AUTORLBENCH_PREPARED/incident_engine/run.py\" --scene \"$AUTORLBENCH_PREPARED/incident\" --prepared \"$AUTORLBENCH_PREPARED/assets\" --native \"$AUTORLBENCH_PREPARED/incident/checkpoints/actor\" --loader \"$AUTORLBENCH_WORKSPACE/loader.py\" --output \"$AUTORLBENCH_RESULTS/experiment_logs/run-home\"",
  "env": {
    "LOG_DIR": "$AUTORLBENCH_RESULTS/experiment_logs",
    "WANDB_MODE": "offline"
  },
  "timeout_s": 14400,
  "log_roots": [
    "experiment_logs"
  ]
}
