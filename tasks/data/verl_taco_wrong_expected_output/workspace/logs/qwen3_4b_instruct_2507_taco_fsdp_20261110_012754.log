[36m(TaskRunner pid=4925)[0m     P = float(P)
[36m(TaskRunner pid=4925)[0m     time = int(time)
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     # Total minutes in a day
[36m(TaskRunner pid=4925)[0m     total_minutes = 1440
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     # Probability that it does NOT rain in a given time period
[36m(TaskRunner pid=4925)[0m     # If the probability of raining in a day is P, then the probability of NOT raining in a day is (1 - P)
