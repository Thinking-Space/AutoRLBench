[36m(TaskRunner pid=4925)[0m [code] def count_interesting_numbers(l, r):
[36m(TaskRunner pid=4925)[0m     # A number has an odd number of divisors if and only if it is a perfect square
[36m(TaskRunner pid=4925)[0m     # This is because divisors generally come in pairs (d, n/d), except when d = sqrt(n)
[36m(TaskRunner pid=4925)[0m     # So only perfect squares have an odd number of divisors
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     def count_perfect_squares(inclusive_start, inclusive_end):
[36m(TaskRunner pid=4925)[0m         # Find the smallest perfect square >= inclusive_start
[36m(TaskRunner pid=4925)[0m         import math
[36m(TaskRunner pid=4925)[0m         sqrt_start = math.ceil(math.sqrt(inclusive_start))
[36m(TaskRunner pid=4925)[0m         # Find the largest perfect square <= inclusive_end
[36m(TaskRunner pid=4925)[0m         sqrt_end = math.floor(math.sqrt(inclusive_end))
[36m(TaskRunner pid=4925)[0m         
[36m(TaskRunner pid=4925)[0m         if sqrt_start > sqrt_end:
[36m(TaskRunner pid=4925)[0m             return 0
[36m(TaskRunner pid=4925)[0m         
[36m(TaskRunner pid=4925)[0m         return sqrt_end - sqrt_start + 1
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     return count_perfect_squares(l, r)
[36m(TaskRunner pid=4925)[0m 
