[36m(TaskRunner pid=4925)[0m [code] def solve_slap_bets(bt1, bt2, mt1, mt2):
[36m(TaskRunner pid=4925)[0m     # Normalize the intervals so that the first point is smaller or equal to the second
[36m(TaskRunner pid=4925)[0m     b_start, b_end = min(bt1, bt2), max(bt1, bt2)
[36m(TaskRunner pid=4925)[0m     m_start, m_end = min(mt1, mt2), max(mt1, mt2)
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     # Check if the intervals are identical (same start and end)
[36m(TaskRunner pid=4925)[0m     if b_start == m_start and b_end == m_end:
[36m(TaskRunner pid=4925)[0m         return "Nothing"
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     # Check if there's no overlap (i.e., the intervals are disjoint)
[36m(TaskRunner pid=4925)[0m     if b_end <= m_start or m_end <= b_start:
[36m(TaskRunner pid=4925)[0m         return "Line"
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     # Otherwise, there's an overlap (more than a point), but we need to check if it's exactly a point
[36m(TaskRunner pid=4925)[0m     # If the overlap is exactly one point, then we have a point intersection
[36m(TaskRunner pid=4925)[0m     if b_end == m_start or m_end == b_start:
[36m(TaskRunner pid=4925)[0m         return "Point"
[36m(TaskRunner pid=4925)[0m     
[36m(TaskRunner pid=4925)[0m     # Otherwise, the intersection is a segment (interval), so return "Line"
[36m(TaskRunner pid=4925)[0m     return "Line"
