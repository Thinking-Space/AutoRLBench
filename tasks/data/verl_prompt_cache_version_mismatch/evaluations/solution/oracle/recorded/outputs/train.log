(TaskRunner pid=[process]) d_i = \sqrt{\frac{52}{65}} = \frac{2 \sqrt{13}}{\sqrt{65}} = \frac{2 \sqrt{13}}{\sqrt{65}} = \frac{2 \sqrt{13}}{\sqrt{65}} = \frac{2 \sqrt{13}}{\sqrt{13 \cdot 5}} = \frac{2}{\sqrt{5}} = \frac{2 \sqrt{5}}{5}
