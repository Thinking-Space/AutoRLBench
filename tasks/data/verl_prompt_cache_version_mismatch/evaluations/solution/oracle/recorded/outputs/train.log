(TaskRunner pid=[process]) 
(TaskRunner pid=[process]) $$
(TaskRunner pid=[process]) (a - c)^2 + (b - d)^2 = (a + c)^2 + (b + d)^2
(TaskRunner pid=[process]) $$
(TaskRunner pid=[process]) 
(TaskRunner pid=[process]) Expanding both sides:
(TaskRunner pid=[process]) 
(TaskRunner pid=[process]) $$
(TaskRunner pid=[process]) a^2 - 2ac + c^2 + b^2 - 2bd + d^2 = a^2 + 2ac + c^2 + b^2 + 2bd + d^2
(TaskRunner pid=[process]) $$
