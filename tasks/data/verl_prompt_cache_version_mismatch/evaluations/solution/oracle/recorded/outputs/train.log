(TaskRunner pid=[process]) $$
(TaskRunner pid=[process]) s = \frac{-2 \pm \sqrt{2^2 - 4(1)(-11.25)}}{2(1)} = \frac{-2 \pm \sqrt{4 + 45}}{2} = \frac{-2 \pm \sqrt{49}}{2}
