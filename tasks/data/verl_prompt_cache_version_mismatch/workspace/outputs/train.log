(TaskRunner pid=[process]) $$
(TaskRunner pid=[process]) x' + y' = 20 + \frac{5y'}{3} + y' = 20 + \frac{8y'}{3}
(TaskRunner pid=[process]) $$
(TaskRunner pid=[process]) 
