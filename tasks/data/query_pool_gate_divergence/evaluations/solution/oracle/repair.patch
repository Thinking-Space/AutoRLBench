+# A bare assignment (unlike `export VAR="$(...)"`, which returns the export builtin's status)
+# propagates the subshell's exit status, so a validator failure aborts here under `set -e`
+# instead of silently yielding an empty value.
+POOL_TOTAL=""
+POOL_SOURCE_MIX=""
+POOL_MIX_SLUG=""
+while IFS='=' read -r _pool_key _pool_value; do
+   case "${_pool_key}" in
+      POOL_TOTAL) POOL_TOTAL="${_pool_value}" ;;
+      POOL_SOURCE_MIX) POOL_SOURCE_MIX="${_pool_value}" ;;
+      POOL_MIX_SLUG) POOL_MIX_SLUG="${_pool_value}" ;;
+      POOL_MESSAGE) echo "${_pool_value}" ;;
+   esac
+done <<<"${_POOL_VALIDATION}"
+unset _pool_key _pool_value _POOL_VALIDATION
+
+for _pool_field in POOL_TOTAL POOL_SOURCE_MIX POOL_MIX_SLUG; do
+   if [ -z "${!_pool_field}" ]; then
+      echo "pool validator did not emit ${_pool_field}" >&2
+      exit 1
+   fi
+done
+unset _pool_field
+export POOL_TOTAL
 
