+def as_count(value, label):
+    """Coerce a manifest or environment count to a non-negative int, or raise a readable error."""
+    if isinstance(value, bool):
+        raise RuntimeError(f"{label} must be an integer, got {value!r}")
+    if isinstance(value, int):
+        number = value
+    elif isinstance(value, float):
+        if not value.is_integer():
+            raise RuntimeError(f"{label} must be an integer, got {value!r}")
+        number = int(value)
+    elif isinstance(value, str):
+        try:
+            number = int(value.strip())
+        except ValueError as exc:
+            raise RuntimeError(f"{label} must be an integer, got {value!r}") from exc
+    else:
+        raise RuntimeError(f"{label} must be an integer, got {value!r}")
+    if number < 0:
+        raise RuntimeError(f"{label} must be non-negative, got {value!r}")
+    return number
