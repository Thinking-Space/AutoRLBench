[36m(TaskRunner pid=6898)[0m [code] def buy_and_sell_stock(N, prices):
[36m(TaskRunner pid=6898)[0m     max_profit = 0
[36m(TaskRunner pid=6898)[0m     for i in range(1, N):
[36m(TaskRunner pid=6898)[0m         if prices[i] > prices[i-1]:
[36m(TaskRunner pid=6898)[0m             max_profit += prices[i] - prices[i-1]
[36m(TaskRunner pid=6898)[0m     return max_profit
[36m(TaskRunner pid=6898)[0m 
