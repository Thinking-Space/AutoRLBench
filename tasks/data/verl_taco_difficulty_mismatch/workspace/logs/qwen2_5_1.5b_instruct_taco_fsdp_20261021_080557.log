[36m(TaskRunner pid=6898)[0m def count_following_subsequences(n, m):
[36m(TaskRunner pid=6898)[0m     # k is the length of the common subsequence
[36m(TaskRunner pid=6898)[0m     k = n - 1
[36m(TaskRunner pid=6898)[0m     # base case: if k is 0, we have singular character as T
[36m(TaskRunner pid=6898)[0m     if k == 0:
[36m(TaskRunner pid=6898)[0m         return m * n
[36m(TaskRunner pid=6898)[0m     # any value > 1 -> arithmetic formula to get number of strings
[36m(TaskRunner pid=6898)[0m     else:
[36m(TaskRunner pid=6898)[0m         # a is base character
[36m(TaskRunner pid=6898)[0m         a = m
[36m(TaskRunner pid=6898)[0m         return a * n * (m - 1)**(k-1)
[36m(TaskRunner pid=6898)[0m 
