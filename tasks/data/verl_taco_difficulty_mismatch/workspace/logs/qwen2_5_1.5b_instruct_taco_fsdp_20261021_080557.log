[36m(TaskRunner pid=6898)[0m def find_good_permutation(n):
[36m(TaskRunner pid=6898)[0m     """Find a good permutation for a given n."""
[36m(TaskRunner pid=6898)[0m     # If n is less than 3, return -1 immediately
[36m(TaskRunner pid=6898)[0m     if n < 3:
[36m(TaskRunner pid=6898)[0m         return [-1]
[36m(TaskRunner pid=6898)[0m     
[36m(TaskRunner pid=6898)[0m     # Create a list of indices
[36m(TaskRunner pid=6898)[0m     indices = list(range(n))
[36m(TaskRunner pid=6898)[0m     # Sort indices
[36m(TaskRunner pid=6898)[0m     indices.sort()
[36m(TaskRunner pid=6898)[0m     
[36m(TaskRunner pid=6898)[0m     # Try to construct a good permutation
[36m(TaskRunner pid=6898)[0m     for i in range(n):
[36m(TaskRunner pid=6898)[0m         # If the current index is greater than or equal to n, break
[36m(TaskRunner pid=6898)[0m         if i >= n:
[36m(TaskRunner pid=6898)[0m             return [-1]
