[36m(TaskRunner pid=6898)[0m def min_cost(n, k, nums):
[36m(TaskRunner pid=6898)[0m     dp = [k] + [0] * (n + 1)
[36m(TaskRunner pid=6898)[0m     count = Counter(nums)
[36m(TaskRunner pid=6898)[0m     
[36m(TaskRunner pid=6898)[0m     for i in range(2, n + 1):
[36m(TaskRunner pid=6898)[0m         if count[i] > 1:
[36m(TaskRunner pid=6898)[0m             dp[i] = dp[i - 1] + 1
[36m(TaskRunner pid=6898)[0m         for j in range(i - 1, 0, -1):
[36m(TaskRunner pid=6898)[0m             if count[i] > count[j]:
[36m(TaskRunner pid=6898)[0m                 dp[i] = min(dp[i], dp[j - 1] + (count[j] - count[i]) * (count[i] - count[j] + 1) // 2)
[36m(TaskRunner pid=6898)[0m     
[36m(TaskRunner pid=6898)[0m     return dp[n]
[36m(TaskRunner pid=6898)[0m 
