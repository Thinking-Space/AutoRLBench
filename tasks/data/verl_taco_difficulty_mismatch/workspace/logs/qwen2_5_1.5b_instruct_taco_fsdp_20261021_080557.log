[36m(TaskRunner pid=6898)[0m def find_min_operations(n, nums):
[36m(TaskRunner pid=6898)[0m     # Find the greatest common divisor (GCD) of the numbers
[36m(TaskRunner pid=6898)[0m     gcd = nums[0]
[36m(TaskRunner pid=6898)[0m     for num in nums[1:]:
[36m(TaskRunner pid=6898)[0m         gcd = math.gcd(gcd, num)
[36m(TaskRunner pid=6898)[0m     
[36m(TaskRunner pid=6898)[0m     # If the GCD is 1, the numbers are already equal, no operations needed
[36m(TaskRunner pid=6898)[0m     if gcd == 1:
[36m(TaskRunner pid=6898)[0m         return 0
[36m(TaskRunner pid=6898)[0m     
[36m(TaskRunner pid=6898)[0m     # Otherwise, the numbers are not all equal, finding the smallest number
[36m(TaskRunner pid=6898)[0m     # that can be achieved by adding a power of 2 to each number
[36m(TaskRunner pid=6898)[0m     smallest_difference = 2
[36m(TaskRunner pid=6898)[0m     for num in nums:
[36m(TaskRunner pid=6898)[0m         op = math.log2(num - 1)
[36m(TaskRunner pid=6898)[0m         if op - math.floor(op) < smallest_difference:
[36m(TaskRunner pid=6898)[0m             smallest_difference = op - math.floor(op)
