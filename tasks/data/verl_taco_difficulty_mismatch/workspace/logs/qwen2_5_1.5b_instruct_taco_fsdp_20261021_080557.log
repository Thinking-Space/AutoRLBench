[36m(TaskRunner pid=6898)[0m def min_points(n, k):
[36m(TaskRunner pid=6898)[0m     """
[36m(TaskRunner pid=6898)[0m     Calculate the minimum number of points required on a circle to construct k regular polygons 
[36m(TaskRunner pid=6898)[0m     with distinct side lengths between 3 and n, minimizing the total number of distinct points.
[36m(TaskRunner pid=6898)[0m     """
[36m(TaskRunner pid=6898)[0m     max_side_value = 2 * ((n // 2) + 1)
[36m(TaskRunner pid=6898)[0m     max_distinct_points = max_side_value + 1
[36m(TaskRunner pid=6898)[0m     if k == 1:
[36m(TaskRunner pid=6898)[0m         return max_distinct_points
[36m(TaskRunner pid=6898)[0m     if k == max_side_value:
[36m(TaskRunner pid=6898)[0m         return max_distinct_points + (k - 1) * max_side_value
[36m(TaskRunner pid=6898)[0m     for side in range(k, 1, -1):
[36m(TaskRunner pid=6898)[0m         total_sides = 2 * ((n // side) + 1.0)
[36m(TaskRunner pid=6898)[0m         if max_distinct_points // total_sides >= k:
[36m(TaskRunner pid=6898)[0m             total_sides -= 1
[36m(TaskRunner pid=6898)[0m         points = max_distinct_points + (total_sides - 1) * side
[36m(TaskRunner pid=6898)[0m         if points <= n:
[36m(TaskRunner pid=6898)[0m             return points
[36m(TaskRunner pid=6898)[0m     return max_distinct_points + k * max_side_value
[36m(TaskRunner pid=6898)[0m 
[36m(TaskRunner pid=6898)[0m # Example usage
[36m(TaskRunner pid=6898)[0m n, k = map(int, input().split())
[36m(TaskRunner pid=6898)[0m print(min_points(n, k))
