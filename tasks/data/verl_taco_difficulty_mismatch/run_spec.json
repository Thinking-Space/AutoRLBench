{
  "schema_version": 1,
  "command": "bash examples/grpo_trainer/run_qwen2_5_1.5b_instruct_taco_fsdp.sh",
  "env": {
    "MODEL_PATH": "$AUTORLBENCH_WORKSPACE/Qwen2.5-1.5B-Instruct",
    "TRAIN_FILE": "$AUTORLBENCH_WORKSPACE/taco_verl/train.parquet",
    "TEST_FILE": "$AUTORLBENCH_WORKSPACE/taco_verl/test.parquet",
    "LOG_DIR": "$AUTORLBENCH_RESULTS/experiment_logs",
    "ROLLOUT_DATA_DIR": "$AUTORLBENCH_RESULTS/experiment_logs/rollout_data",
    "VALIDATION_DATA_DIR": "$AUTORLBENCH_RESULTS/experiment_logs/validation_data",
    "WANDB_MODE": "offline",
    "WANDB_DIR": "$AUTORLBENCH_RESULTS/experiment_logs",
    "WANDB_API_KEY": "offline",
    "NGPUS_PER_NODE": "4",
    "NNODES": "1",
    "TOTAL_TRAINING_STEPS": "400",
    "TEST_FREQ": "50"
  },
  "timeout_s": 43200,
  "log_roots": ["experiment_logs"]
}
