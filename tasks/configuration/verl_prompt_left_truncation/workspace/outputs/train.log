[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Recall:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b = d - 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
