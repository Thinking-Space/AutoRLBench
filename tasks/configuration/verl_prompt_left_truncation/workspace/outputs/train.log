[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 540 \left( \frac{1}{s} - \frac{1}{s + 2} \right) = 96
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Simplify the fraction:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
