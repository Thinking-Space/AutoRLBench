[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m s = \frac{-8 \pm \sqrt{784}}{8}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m s = \frac{-8 \pm 28}{8}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Two solutions:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m - $ s = \frac{-8 + 28}{8} = \frac{20}{8} = 2.5 $
[36m(TaskRunner pid=14021)[0m - $ s = \frac{-8 - 28}{8} = \frac{-36}{8} = -4.5 $ (discarded, since speed cannot be negative)
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m s = 2.5 \text{ km/h}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### **Step 7: Find $ t $**
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Use equation (1):
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 9 = s \left(4 - \frac{t}{60}\right)
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Substitute $ s = 2.5 $:
[36m(TaskRunner pid=14021)[0m 
