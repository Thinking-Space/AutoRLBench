[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 1: Understand the notation
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m In base $ b $, the number $ 17_b $ means:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 17_b = 1 \cdot b + 7 = b + 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Similarly, the number $ 97_b $ means:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 97_b = 9 \cdot b + 7 = 9b + 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m We are to find all **integer bases $ b > 9 $** such that:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b + 7 \text{ divides } 9b + 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m That is:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b + 7 \mid 9b + 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 2: Use the divisibility condition
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m We want:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b + 7 \mid 9b + 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m This means:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 9b + 7 = k(b + 7) \quad \text{for some integer } k
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Let’s solve for $ k $:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 9b + 7 = k(b + 7)
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Expand the right-hand side:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 9b + 7 = kb + 7k
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Now bring all terms to one side:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 9b + 7 - kb - 7k = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Factor:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b(9 - k) + (7 - 7k) = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Now solve for $ b $:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b(9 - k) = 7k - 7
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m b = \frac{7k - 7}{9 - k}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
