[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m s = \frac{-2 \pm 7}{2}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m - $ s = \frac{-2 + 7}{2} = \frac{5}{2} = 2.5 $
[36m(TaskRunner pid=14021)[0m - $ s = \frac{-2 - 7}{2} = -4.5 $ (discarded, since speed can't be negative)
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m s = 2.5 \text{ km/h}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
