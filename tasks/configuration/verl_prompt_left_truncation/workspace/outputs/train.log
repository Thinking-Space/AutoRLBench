[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 8: Use vector approach or coordinate geometry
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Let’s place the triangle in the coordinate plane.
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Let’s place the circumcenter $ O $ at the origin.
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Let’s denote:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m - $ O = (0, 0) $
[36m(TaskRunner pid=14021)[0m - $ I = (x, y) $
[36m(TaskRunner pid=14021)[0m - $ A = (x_A, y_A) $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m We are given that $ \overline{IA} \perp \overline{OI} $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m \vec{IA} \cdot \vec{OI} = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m Let’s compute:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m - $ \vec{IA} = A - I = (x_A - x, y_A - y) $
[36m(TaskRunner pid=14021)[0m - $ \vec{OI} = I - O = (x, y) $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m (x_A - x)(x) + (y_A - y)(y) = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m x_A x - x^2 + y_A y - y^2 = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m x_A x + y_A y = x^2 + y^2
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m But $ O = (0, 0) $, and $ I = (x, y) $, so:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m x^2 + y^2 = |OI|^2
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m x_A x + y_A y = |OI|^2
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m This is the condition that $ \vec{IA} \perp \vec{OI} $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 9: Use known formulas for $ IO $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m There is a known formula for the distance between the incenter and circumcenter:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IO^2 = R(R - 2r)
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m This is a **standard result** in triangle geometry.
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IO^2 = R(R - 2r) = 13(13 - 2 \cdot 6) = 13(13 - 12) = 13 \cdot 1 = 13
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IO = \sqrt{13}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 10: Use the condition $ \vec{IA} \perp \vec{OI} $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m We have:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m \vec{IA} \cdot \vec{OI} = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IA \cdot OI = 0
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IA \perp OI
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So the incenter $ I $ lies on the circle with center $ O $ and radius $ \sqrt{13} $, and $ IA \perp OI $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 11: Use the formula for $ IA $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m The length of $ IA $ is given by:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IA = \sqrt{R^2 - (IO)^2} = \sqrt{13^2 - (\sqrt{13})^2} = \sqrt{169 - 13} = \sqrt{156}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IA = \sqrt{156}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ---
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m ### Step 12: Use the formula for $ IA $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m We also have:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m IA = \frac{r}{\sin \frac{A}{2}}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m \sqrt{156} = \frac{6}{\sin \frac{A}{2}}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m \sin \frac{A}{2} = \frac{6}{\sqrt{156}} = \frac{6}{2\sqrt{39}} = \frac{3}{\sqrt{39}} = \frac{\sqrt{39}}{13}
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 
