[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m 9b + 7 \equiv 0 \pmod{b + 7}
[36m(TaskRunner pid=14021)[0m $$
