[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m - $ A = 6s $
[36m(TaskRunner pid=14021)[0m - $ abc = 52A = 52 \cdot 6s = 312s $
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m So:
[36m(TaskRunner pid=14021)[0m 
[36m(TaskRunner pid=14021)[0m $$
[36m(TaskRunner pid=14021)[0m abc = 312s
