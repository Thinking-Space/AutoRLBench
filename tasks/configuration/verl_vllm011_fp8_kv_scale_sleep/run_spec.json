{
  "schema_version": 1,
  "command": "mkdir -p \"$AUTORLBENCH_RESULTS/experiment_logs\" && bash run_grpo.sh",
  "env": {
    "MODEL": "$AUTORLBENCH_WORKSPACE/models/Qwen3-4B",
    "NGPU": "2",
    "STEPS": "3",
    "EXP": "grpo",
    "LOG_DIR": "$AUTORLBENCH_RESULTS/experiment_logs",
    "VERL_FILE_LOGGER_PATH": "$AUTORLBENCH_RESULTS/experiment_logs/metrics.jsonl",
    "WANDB_MODE": "offline",
    "WANDB_API_KEY": "offline",
    "WANDB_SILENT": "true",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1"
  },
  "timeout_s": 21600,
  "log_roots": [
    "experiment_logs"
  ]
}
