[36m(TaskRunner pid=57070)[0m     def getAngle(self, H, M):
[36m(TaskRunner pid=57070)[0m         # Convert hours to whole circle factors
[36m(TaskRunner pid=57070)[0m         H_factors = H % 12
[36m(TaskRunner pid=57070)[0m         M_factors = M
[36m(TaskRunner pid=57070)[0m     
[36m(TaskRunner pid=57070)[0m         # Calculate the positions of the hour and minute hands
[36m(TaskRunner pid=57070)[0m         hour_angle = H_factors * 30 + (M_factors * 0.5)
[36m(TaskRunner pid=57070)[0m         minute_angle = M_factors * 6
[36m(TaskRunner pid=57070)[0m     
[36m(TaskRunner pid=57070)[0m         # Calculate the absolute difference between the two angles
