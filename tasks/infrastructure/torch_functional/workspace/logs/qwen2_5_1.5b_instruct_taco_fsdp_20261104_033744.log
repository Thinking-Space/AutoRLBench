[36m(TaskRunner pid=57070)[0m     def isIsogram(self, s):
[36m(TaskRunner pid=57070)[0m         # Split the input string into a list of characters
[36m(TaskRunner pid=57070)[0m         char_list = list(s.lower())
[36m(TaskRunner pid=57070)[0m         
[36m(TaskRunner pid=57070)[0m         # Use Counter to count the occurrences of each character
[36m(TaskRunner pid=57070)[0m         char_count = Counter(char_list)
[36m(TaskRunner pid=57070)[0m         
[36m(TaskRunner pid=57070)[0m         # Check if any character occurs more than once
[36m(TaskRunner pid=57070)[0m         return all(count <= 1 for count in char_count.values())
