[36m(TaskRunner pid=57070)[0m     
[36m(TaskRunner pid=57070)[0m         # Ensure the angle is the minimum of the two possible angles
[36m(TaskRunner pid=57070)[0m         min_angle = min(angle_diff, 360 - angle_diff)
[36m(TaskRunner pid=57070)[0m     
[36m(TaskRunner pid=57070)[0m         # Return the floor of the final angle
[36m(TaskRunner pid=57070)[0m         return int(math.floor(min_angle))
