[36m(TaskRunner pid=57070)[0m 
[36m(TaskRunner pid=57070)[0m     def noOfGroups(self, N, Arr):
[36m(TaskRunner pid=57070)[0m         # Count occurrences of each remainder when numbers are divided by 3
[36m(TaskRunner pid=57070)[0m         sums = Counter(remainder for num in Arr for remainder in [num, num - 2, num - 5])
[36m(TaskRunner pid=57070)[0m         
[36m(TaskRunner pid=57070)[0m         # Total count of valid groupings can be calculated as C(N,2) + C(N,3)
[36m(TaskRunner pid=57070)[0m         total = 0
[36m(TaskRunner pid=57070)[0m         for remainder, freq in sums.items():
[36m(TaskRunner pid=57070)[0m             if remainder % 3 == 1 or (remainder == 0 and N > 2):
[36m(TaskRunner pid=57070)[0m                 total += freq * (freq - 1) // 2
[36m(TaskRunner pid=57070)[0m             elif remainder % 3 == 2:
[36m(TaskRunner pid=57070)[0m                 total += freq * (freq - 1) // 2 * (freq - 2) // 3
[36m(TaskRunner pid=57070)[0m         
[36m(TaskRunner pid=57070)[0m         return total
[36m(TaskRunner pid=57070)[0m 
