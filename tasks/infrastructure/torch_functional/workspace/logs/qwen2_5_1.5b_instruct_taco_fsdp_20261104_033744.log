[36m(TaskRunner pid=57070)[0m [code] class Solution:
[36m(TaskRunner pid=57070)[0m     def getLine(self, a, b, c, d):
[36m(TaskRunner pid=57070)[0m         # Use the formula for the slope of the line passing through two points
[36m(TaskRunner pid=57070)[0m         m = (b - d) / float(a - c)
[36m(TaskRunner pid=57070)[0m         
[36m(TaskRunner pid=57070)[0m         # Since we have one point, the equation of the line can be simplified to just y = mx
