[36m(TaskRunner pid=57070)[0m [code] class Solution:
[36m(TaskRunner pid=57070)[0m     def sentencePalindrome(self, s):
[36m(TaskRunner pid=57070)[0m         # Remove all non-alphabetic characters and convert to lowercase
