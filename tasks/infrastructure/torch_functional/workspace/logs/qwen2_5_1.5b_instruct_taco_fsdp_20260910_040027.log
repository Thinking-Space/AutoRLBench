[36m(TaskRunner pid=6902)[0m [code] def bits_war(numbers):
[36m(TaskRunner pid=6902)[0m     odd_count = sum(1 for num in numbers if num % 2 != 0)
[36m(TaskRunner pid=6902)[0m     even_count = len(numbers) - odd_count
