def is_perfect_square(x):
    s = int(math.sqrt(x))
    return s * s == x
def find_good_permutation(n):
    if n < 1 or n > 10**5:
        return -1
    permutation = [-1] * n
    visited = [False] * n
    i = 0
    while i < n:
        if not visited[i]:
            j = i
            while not visited[j]:
                visited[j] = True
                j = (j + 1) % n
                i = (i + 1) % n
            permutation[i] = j
            i += 1
    for i in range(n):
        if not is_perfect_square(permutation[i] + i):
            return -1
    return permutation
