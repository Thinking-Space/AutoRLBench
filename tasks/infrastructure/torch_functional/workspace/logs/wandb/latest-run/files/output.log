[code] def dashatize(num):
    # Convert the number to a string
    num_str = str(num)
    # Initialize an empty string to store the result
    result = ""
    # Iterate through each character in the string
    for i in range(len(num_str)):
        # Check if the character is odd
        if i == 0 or (i > 0 and i % 2 == 1):
            # If the character is odd, add a dash before it
            result += "- "
        # Add the character (including both dashes where appropriate)
        result += num_str[i]
    # Remove the opening dash marks and return the result
    return result[3:]
