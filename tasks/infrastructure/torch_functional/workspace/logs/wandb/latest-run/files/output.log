[code] import datetime
import math
def half_life(person1, person2):
    # Convert birthdates to datetime objects
    birthdates = [datetime.datetime.strptime(date, "%Y-%m-%d") for date in [person1, person2]]
    # Calculate the age difference
    age_diff = (birthdates[1] - birthdates[0]).days
    # Calculate the younger age
    younger_age = min(age_diff, -age_diff)
    # Calculate the target date
    target_date = birthdates[0] + datetime.timedelta(days=youngest_age)
    # Return the result as a string
    return target_date.strftime("%Y-%m-%d")
