Have fun! def asterisc_it(n):
	\nUse Call-Based format
[code] def asterisc_it(n):
	# Check if the input is an integer
	if isinstance(n, int):
		digits = list(str(abs(n)))
	else:
		digits = n
	res = ""
	i = 0
	while i < len(digits):
		if int(digits[i]) % 2 == 0:
			if i == len(digits) - 1 or not int(digits[i+1]) % 2 == 0:
				res += digits[i]
			else:
				res += digits[i] + "*"
			i += 2
		else:
			res += digits[i]
			i += 1
	return res
