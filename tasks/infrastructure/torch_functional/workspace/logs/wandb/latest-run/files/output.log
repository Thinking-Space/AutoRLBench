[code] class Solution:
    def printMinIndexChar(self, S, patt):
        min_index = None
        min_char = "?"
        for char in patt:
            index = -1
            char_index = -1
            for i in range(len(S)):
                if S[i] == char:
                    index = i
                if index != -1:
                    char_index = i
            if index != -1:
                if (min_index is None or index < min_index):
                    min_index = index
                    min_char = char
        return min_char
