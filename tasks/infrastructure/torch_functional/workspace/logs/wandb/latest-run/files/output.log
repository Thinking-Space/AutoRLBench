[code] from collections import defaultdict, Counter
def uniq_c(seq):
    res = []
    count = Counter()
    # Count the occurrence of each item in the input sequence
    count.update(seq)
    # Iterate over the input sequence and append unique items and their counts to the output list
    for item in seq:
        if count[item] == 1:
            res.append((item, 1))
    return res
