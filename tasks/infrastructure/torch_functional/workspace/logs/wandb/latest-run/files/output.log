[code] # Setting up a hash, to store the character ascii values
alphabet = {}
def char_to_ascii(string):
    # Remove all spaces from the string
    string = string.replace(" ", "")
    # If the string is empty, return nil
    if len(string) == 0:
        return None
    # Iterate over each character in the string
    for char in string.lower():
        # Only add alphanumeric characters to the hash
        # Convert the character to lowercase first, just in case it's uppercase
        if "-" in char:
            continue
        if char.isdigit():
            alphabet[char] = int(char)
        elif "." in char:
            continue
        else:
            alphabet[char] = ord(char)
    # Return the hash
    return alphabet
