1 <= N <= 10^{18} #User function Template for python3
class Solution:
	def is_power_of_eight(self, n):
		# Code here\nUse Call-Based format
[code] def is_power_of_eight(n):
    # Handle edge case: 1 is a power of 8
    if n == 1:
        return "Yes"
    power = 1
    while power < n:
        power *= 8
    return "Yes" if power == n else "No"
