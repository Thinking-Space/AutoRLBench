[code] def evalTree(self, root):
    def evaluate(node):
        if node is None:
            return 0
        # If the node is a leaf (basic binary operator), return its value
        if node.val != '+' or node.left is None or node.right is None:
            return node.val
        # Recursively evaluate left and right subtrees
        left = evaluate(node.left)
        right = evaluate(node.right)
        # Perform the operation based on the node
        if node.val == '+':
            return left + right
        elif node.val == '-':
            return left - right
        elif node.val == '*':
            return left * right
        elif node.val == '/':
            return left // right
    return evaluate(root)
