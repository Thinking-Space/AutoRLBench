[code] textInput:
class Solution:
    def findTheLongestSubstring(self, s: str) -> int:
        ans = 0
        seen = {0: -1}
        bitmask = 0
        for i, c in enumerate(s):
            if c == 'a':
                bitmask ^= 1
            else:
                bitmask ^= 2
            if bitmask in seen:
                ans = max(ans, i - seen[bitmask])
            else:
                seen[bitmask] = i
        return ans
