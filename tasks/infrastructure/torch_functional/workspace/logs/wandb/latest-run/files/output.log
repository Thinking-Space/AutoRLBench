def is_split_possible(s):
    if len(s) < 4:
        return "NO"
    if len(s) == 4:
        return "YES"
    for i in range(1, len(s) - 1):
        if len(set(s[:i])) == len(s[:i]) and len(set(s[i:])) == len(s[i:]) and len(set(s[:i] + s[i+1:])) == len(set(s[:i] + s[i+1:])):
            return "YES"
    return "NO"
