[code] def longest_palindrome(s):
    if not s or len(s) == 0:
        return 0
    current_max = 0
    for i in range(len(s)):
        left, right = s[i], s[i]
        while left < len(s) and right >= 0 and s[left] == s[right]:
            left -= 1
            right += 1
            current_max = max(current_max, right - left - 1)
        left = s[i]; right = s[i]
        while left >= 0 and right < len(s) and s[left] == s[right]:
