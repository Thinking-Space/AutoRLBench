{
  "workload": "public repository debugging, multi-turn tool calls",
  "model": {
    "path": "models/Qwen3.5-35B-A3B"
  },
  "conversion": {
    "gpus": 8,
    "pp": 8
  },
  "topology": {
    "actor_gpus": 4,
    "rollout_gpus": 4,
    "rollout_gpus_per_engine": 2
  },
  "training": {
    "tp": 1,
    "ep": 4,
    "max_tokens_per_gpu": 3072,
    "lr": 1e-06,
    "optimizer_cpu_offload": true,
    "grads_in_fp32": false,
    "log_probs_max_tokens_per_gpu": 3072,
    "fused_logprob_seq_chunk_size": 512
  },
  "rollout": {
    "data": "data/public_repo_tasks.jsonl",
    "num_rollout": 3,
    "batch_groups": 16,
    "samples_per_group": 4,
    "max_turns": 8,
    "max_new_tokens_per_turn": 2048,
    "max_context_len": 12288,
    "tool_call_parser": "qwen3_coder",
    "sglang_mem_fraction": 0.8,
    "server_concurrency": 256
  },
  "router": {
    "use_miles_router": true,
    "policy": "consistent_hashing"
  },
  "env": {
    "MILES_EXPERIMENTAL_ROLLOUT_REFACTOR": "0",
    "PUBLIC_ASYNC_MAX_INFLIGHT_GROUPS": "64",
    "PUBLIC_ASYNC_QUEUE_MAXSIZE": "64",
    "TOOL_LATENCY_SCALE": "1.0"
  },
  "services": [],
  "extra_args": []
}
