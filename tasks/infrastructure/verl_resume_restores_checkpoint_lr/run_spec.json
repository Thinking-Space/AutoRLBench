{
  "schema_version": 1,
  "command": "mkdir -p \"$AUTORLBENCH_RESULTS/experiment_logs\" && bash run_resume.sh",
  "env": {
    "MODEL": "$AUTORLBENCH_WORKSPACE/models/Qwen3-4B",
    "NGPU": "2",
    "STAGE1_STEPS": "2",
    "STEPS": "5",
    "LR1": "1e-6",
    "LR2": "2e-6",
    "OUT": "$AUTORLBENCH_RESULTS/experiment_logs",
    "WANDB_MODE": "offline",
    "WANDB_API_KEY": "offline",
    "WANDB_SILENT": "true",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1"
  },
  "timeout_s": 21600,
  "log_roots": [
    "experiment_logs"
  ]
}
