{
  "schema_version": 1,
  "command": "mkdir -p \"$AUTORLBENCH_RESULTS/experiment_logs\" && bash run_grpo_lora.sh",
  "env": {
    "LOG_DIR": "$AUTORLBENCH_RESULTS/experiment_logs",
    "WANDB_MODE": "offline",
    "WANDB_DIR": "$AUTORLBENCH_RESULTS/experiment_logs",
    "WANDB_SILENT": "true",
    "WANDB_API_KEY": "offline",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1"
  },
  "timeout_s": 9000,
  "log_roots": [
    "experiment_logs"
  ]
}
