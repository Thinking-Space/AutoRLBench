+def _register_nvfp4_sleep_buffers(model):
+    from qat_kv.nvfp4_rollout import plan_resync
+
+    # codex: vLLM preserves named buffers during level-2 sleep. The actor
+    # re-sync consumes these fixed scales but only rewrites packed weights.
+    fields = ("input_global_scale", "weight_global_scale", "alpha", "input_global_scale_inv")
+    buffers = []
+    for name in plan_resync(model):
+        layer = model.get_submodule(name)
+        for field in fields:
+            value = layer.get_parameter(field)
+            if value.requires_grad:
+                raise ValueError(f"{name}.{field} must be frozen")
+            buffers.append((layer, field, value.detach()))
+    for layer, field, value in buffers:
+        delattr(layer, field)
+        layer.register_buffer(field, value)
+    return len(buffers)
+
