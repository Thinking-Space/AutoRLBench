[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Which means:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m b + 7 \mid 56
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m ---
