[36m(TaskRunner pid=25285)[0m - $ \frac{1}{34} $
[36m(TaskRunner pid=25285)[0m - $ -\frac{1}{34} $
[36m(TaskRunner pid=25285)[0m - $ \frac{-1 + \sqrt{273}}{68} $
[36m(TaskRunner pid=25285)[0m - $ \frac{1 - \sqrt{273}}{68} $
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Now, sum them:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
