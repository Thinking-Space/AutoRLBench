[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m But we also have:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m A = 6s
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m So:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m \frac{1}{2} bc \sin A = 6s
[36m(TaskRunner pid=25285)[0m \Rightarrow bc \sin A = 12s
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m But we also have:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m abc = 312s
[36m(TaskRunner pid=25285)[0m \Rightarrow bc = \frac{312s}{a}
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m So:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
