[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Try $ s = 6 $:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Then:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
