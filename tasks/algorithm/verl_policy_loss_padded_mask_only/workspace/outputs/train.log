[36m(TaskRunner pid=25285)[0m - $AB = c$
[36m(TaskRunner pid=25285)[0m - $AC = b$
[36m(TaskRunner pid=25285)[0m - $BC = a$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Then:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m s = \frac{a + b + c}{2}
