[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m This is a well-known formula:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m OI^2 = R(R - 2r)
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Given $R = 13$, $r = 6$, we compute:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m OI^2 = 13(13 - 12) = 13 \cdot 1 = 13
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m So:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m OI = \sqrt{13}
