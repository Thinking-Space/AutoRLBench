[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 137^2 = 18769, \quad 18769 - 321 = 18448
[36m(TaskRunner pid=25285)[0m $$
