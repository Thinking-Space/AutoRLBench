[36m(TaskRunner pid=25285)[0m 1 \cdot b + 7 = b + 7
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Similarly, the number $ 97_b $ is:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 9 \cdot b + 7 = 9b + 7
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m We are told that $ 17_b $ divides $ 97_b $, i.e.,
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
