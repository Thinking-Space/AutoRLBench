[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 9b + 7 = 9(b + 7) - 56
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m So,
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 9b + 7 = 9(b + 7) - 56
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m Therefore,
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 9b + 7 \equiv -56 \pmod{b + 7}
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m But we are told that $ 9b + 7 \equiv 0 \pmod{b + 7} $, so:
