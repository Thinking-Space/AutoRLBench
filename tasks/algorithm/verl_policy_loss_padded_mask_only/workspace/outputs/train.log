[36m(TaskRunner pid=25285)[0m So:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m CD = \frac{18448}{2312^2}
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m So:
[36m(TaskRunner pid=25285)[0m 
[36m(TaskRunner pid=25285)[0m $$
[36m(TaskRunner pid=25285)[0m (A + B)^2 = \frac{137}{1156} + 2 \cdot \sqrt{ \frac{18448}{2312^2} }
