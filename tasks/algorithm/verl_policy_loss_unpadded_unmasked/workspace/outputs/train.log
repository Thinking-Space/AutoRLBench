[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m AC^2 = (-a - a)^2 + (-b - b)^2 = (-2a)^2 + (-2b)^2 = 4a^2 + 4b^2
[36m(TaskRunner pid=13660)[0m $$
