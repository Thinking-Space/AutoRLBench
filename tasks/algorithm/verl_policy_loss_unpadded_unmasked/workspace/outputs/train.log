[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m AB \cdot AC = R^2 - r^2 = 13^2 - 6^2 = 169 - 36 = 133
[36m(TaskRunner pid=13660)[0m $$
