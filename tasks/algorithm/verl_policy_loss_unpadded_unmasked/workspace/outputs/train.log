[36m(TaskRunner pid=13660)[0m 38^2 = 676 + 2bc
[36m(TaskRunner pid=13660)[0m \Rightarrow 1444 = 676 + 2bc
[36m(TaskRunner pid=13660)[0m \Rightarrow 2bc = 1444 - 676 = 768
[36m(TaskRunner pid=13660)[0m \Rightarrow bc = 384
[36m(TaskRunner pid=13660)[0m $$
