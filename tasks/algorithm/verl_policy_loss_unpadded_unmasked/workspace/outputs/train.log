[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m \frac{1080}{s(s + 2)} = 116
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m s(s + 2) = \frac{1080}{116} = \frac{270}{29}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Now solve:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m s^2 + 2s - \frac{270}{29} = 0
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Multiply by 29:
