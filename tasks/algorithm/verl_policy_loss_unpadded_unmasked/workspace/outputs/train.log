[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Substitute $ t = 144 - 48s $:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m \frac{9}{s} = 4 - \frac{144 - 48s}{60}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Multiply both sides by 60:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m \frac{540}{s} = 240 - (144 - 48s)
