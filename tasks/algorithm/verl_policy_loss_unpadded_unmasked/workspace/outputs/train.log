[36m(TaskRunner pid=13660)[0m \frac{(-\frac{bd}{a})^2}{20} - \frac{d^2}{24} = 1
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m \frac{b^2 d^2}{20a^2} - \frac{d^2}{24} = 1
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Factor out $d^2$:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m d^2 \left( \frac{b^2}{20a^2} - \frac{1}{24} \right) = 1
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Let’s denote:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m k = \frac{b^2}{20a^2} - \frac{1}{24}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Then:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m d^2 = \frac{1}{k}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m So:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m c^2 = \frac{b^2 d^2}{a^2} = \frac{b^2}{a^2} \cdot \frac{1}{k}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Now, we want to find $c^2 + d^2$:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m c^2 + d^2 = \frac{b^2}{a^2} \cdot \frac{1}{k} + \frac{1}{k} = \frac{1}{k} \left( \frac{b^2}{a^2} + 1 \right)
[36m(TaskRunner pid=13660)[0m $$
