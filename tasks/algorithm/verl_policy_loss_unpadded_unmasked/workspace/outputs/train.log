[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 9 - \frac{56}{b + 7} = k
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
