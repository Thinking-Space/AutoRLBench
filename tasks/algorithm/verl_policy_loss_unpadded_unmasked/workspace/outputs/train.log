[36m(TaskRunner pid=13660)[0m = \frac{540 + 2T}{60}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Multiply both sides by 60:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 540 = 540 + 2T
[36m(TaskRunner pid=13660)[0m \Rightarrow 2T = 0 \Rightarrow T = 0
