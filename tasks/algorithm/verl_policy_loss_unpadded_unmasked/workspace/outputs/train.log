[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m t = 144 - 48s = 144 - 48(2.5) = 144 - 120 = 24
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m So $ t = 24 $ minutes.
[36m(TaskRunner pid=13660)[0m 
