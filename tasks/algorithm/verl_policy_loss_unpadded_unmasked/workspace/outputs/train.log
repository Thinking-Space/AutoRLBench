[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m So:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 6 = \frac{b + c - 26}{2} \Rightarrow b + c = 26 + 12 = 38
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m So:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m b + c = 38 \tag{5}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Now we have:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m - $ b + c = 38 $
[36m(TaskRunner pid=13660)[0m - $ b^2 + c^2 = 676 $
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m We can solve for $ bc $
[36m(TaskRunner pid=13660)[0m 
