[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Combine like terms:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 0 = (2.4s - 4s) + 4.8 - \frac{t(s + 2) - ts}{60}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 0 = -1.6s + 4.8 - \frac{ts + 2t - ts}{60}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 0 = -1.6s + 4.8 - \frac{2t}{60}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 1.6s = 4.8 - \frac{2t}{60}
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m Multiply both sides by 60:
[36m(TaskRunner pid=13660)[0m 
[36m(TaskRunner pid=13660)[0m $$
[36m(TaskRunner pid=13660)[0m 96s = 288 - 2t
