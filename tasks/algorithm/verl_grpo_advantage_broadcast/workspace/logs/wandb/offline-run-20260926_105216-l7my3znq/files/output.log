[code] def rounding(n, m):
    # Calculate the rounded value
    rounded_value = abs(n - m) < abs(2 * m - n)
    # Check if n is exactly in the middle of 2 multiples of m
    if abs(n - m) == abs(2 * m - n):
        return n
    # Round to the nearest multiple of m
    rounded_value = (n - m) < 0
    return m if rounded_value else m + (m - n % m)
