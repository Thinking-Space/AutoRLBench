# Function to check if a number is a beautiful divisor
def is_beautiful_divisor(num):
    # Calculate the number of beautiful divisors
    count = pow(2, num.bit_length() + 1) - pow(pow(2, num.bit_length() + 1) - 1, 2)
    # Check if it's more than 1
    return count > 0
# Function to find the greatest beautiful divisor
def greatest_beautiful_divisor(n):
    max_divisor = 1
    # Iterate from the largest beautiful divisor down to 1
    for i in range(n.bit_length() + 1, 1, -1):
        # Check if i is a beautiful divisor
        if is_beautiful_divisor(i):
            # If it is, update the maximum divisor
            max_divisor = i
            # Stop checking any further
            break
    return max_divisor
