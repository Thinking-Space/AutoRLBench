[code] from bisect import *
class Solution:
    def findElements(self, a, n):
        # Convert the list to a sorted list
        sorted_list = sorted(a)
        result = []
        # Traverse the list and find elements at least 2 positions away from the end
        for i in range(n-1, 1, -1):
            if sorted_list[i-2] < sorted_list[i] < sorted_list[i-1]:
                result.append(sorted_list[i-2])
        # Sort the result list
        result.sort()
        return result
