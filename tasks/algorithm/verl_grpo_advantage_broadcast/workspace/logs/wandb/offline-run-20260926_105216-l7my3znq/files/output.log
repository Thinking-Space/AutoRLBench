[code] def sort_by_value_and_index(arr):
    # Create a list of tuples (value, index * 1000) to sort by
    sorted_list = sorted(enumerate(arr), key=lambda x: x[1] * 1000 + x[0])
    # Extract the index from the tuples
    sorted_indices = [index for index, value in sorted_list]
    # Create the final result array with the correct indices
    result = [arr[i] for i in sorted_indices]
    return result
