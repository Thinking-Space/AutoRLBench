[code] from collections import deque
class Solution:
    def countRotations(self, N):
        # Convert the number into a string to facilitate rotation
        digits = deque(str(N))
        count = 0
        # Iterate through each possible rotation
        for i in range(len(digits)):
            rotated = int(''.join(digits))
            # Check if the rotated number is divisible by 4
            if rotated % 4 == 0:
                count += 1
        return count
