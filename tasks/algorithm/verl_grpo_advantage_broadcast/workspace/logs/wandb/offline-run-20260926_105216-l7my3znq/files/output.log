There aren't necessarily only three cups in this game, but there wil...[+147 chars]
[code] def find_the_ball(start, swaps):
    # Create a dictionary to store the cup mappings
    cups = {start: start}
    # Simulate each swap
    for swap in swaps:
        # Get the current start cup
        current_start = cups[start]
        # Find the swap partner for the current start
        swap_partner = swap[1]
        # Update the cup mappings
        cups[current_start] = swap_partner
        cups[swap_partner] = current_start
    # Return the final position of the ball
    return cups[start]
