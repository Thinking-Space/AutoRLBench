[code] def is_strong_palindrome(S):
    # Check if S is a palindrome
    if S != S[::-1]:
        return "No"
    # Check if the first half (excluding the last character) is a palindrome
    mid = len(S) // 2
    if S[:mid] != S[:mid:-1]:
        return "No"
    # Check if the second half (excluding the first character) is a palindrome
    if S[mid:] != S[mid+1:][::-1]:
        return "No"
    return "Yes"
# Example usage
