def next_smaller_permutation(X):
    # Convert X to a list of its digits
    digits = list(str(X))
    # Generate all permutations of the digits
    perms = list(itertools.permutations(digits))
    # Convert each permutation back to an integer
    perm_numbers = [int(''.join(p)) for p in perms]
    # Find the first permutation that is greater than X
    for perm in perm_numbers:
