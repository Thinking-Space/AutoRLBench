[code] def pop_shift(s):
    """
    This function takes a string 's' and returns an array of three strings
    by repeatedly removing characters from the end and beginning of the string
    until only one character is left.
    """
    # Loop until the length of the string is less than 3
    while len(s) > 2:
        # Remove the last character
        s = s[:-1]
        # Append the last character to the first solution string
        return [s.strip(), s, s[1:]]
