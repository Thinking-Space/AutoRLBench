[code] def switcheroo(string):
    # Use a set to keep track of the positions where 'a' appears
    positions = []
    for i, char in enumerate(string):
        if char == 'a':
            positions.append(i)
    # For each 'a' position, switch it with the next 'b' position
    for i in range(len(positions)):
        if i + 1 < len(positions):
            string_list = list(string)
            a_index, b_index = positions[i], positions[i + 1]
            string_list[a_index], string_list[b_index] = string_list[b_index], string_list[a_index]
            string = ''.join(string_list)
    return string
