import re
def kebabize(string):
    # Remove non-word characters and convert to lowercase
    string = re.sub(r'\W+', '-', string.lower())
    # Handle special case where there is no split
    if not string:
        string = 'apple'
    # Convert the string to a list of parts and join with hyphens
    return '-'.join(string.split())
