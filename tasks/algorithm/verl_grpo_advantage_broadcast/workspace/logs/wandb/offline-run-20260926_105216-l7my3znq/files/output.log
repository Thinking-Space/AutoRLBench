[code] class Solution:
    def thousandSeparator(self, n: int) -> str:
        # Convert the integer to a string
        num_str = str(n)
        # Use list comprehension to insert a dot every three characters
        result = '.'.join(['.' + num_str[i:(i+3)] for i in range(0, len(num_str), 3)])
        return result[:-1] if result[-1] == '0' else result
