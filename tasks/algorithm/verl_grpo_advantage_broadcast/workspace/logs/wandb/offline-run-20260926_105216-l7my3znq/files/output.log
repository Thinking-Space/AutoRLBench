    def isPowerOfFour(self, num: int) -> bool:
        \nUse Call-Based format
[code] # Write your code here
class Solution:
    def isPowerOfFour(self, num: int) -> bool:
        # A number is a power of 4 if and only if it has exactly one bit set to 1 and this bit is at an odd position
        return num > 0 and (num & (num - 1)) == 0 and ((num - 1) & -num) == num - 1
