[code] class Solution:
    def possible(self, arr, n):
        # Sort the array to check the sum of an arithmetic sequence
        arr.sort()
        # Calculate the required sum for every student's arrangement
        total = (n * (n + 1)) // 2
        for i in range(n):
            if arr[i] != i + 1:
                if arr[i] * (i + 1) != total:
                    return "NO"
        return "YES"
