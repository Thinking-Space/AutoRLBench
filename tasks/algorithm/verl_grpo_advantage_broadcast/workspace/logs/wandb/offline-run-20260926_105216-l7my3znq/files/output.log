[code] class Solution:
    def modify(self, s):
        vowels = 'aeiouAEIOU'
        stack = []
        result = list(s)
        # Push vowels onto the stack
        for char in s:
            if char in vowels:
                stack.append(char)
        # Pop vowels from the stack for the corresponding positions in the result list
        for i, char in enumerate(s):
            if char in vowels:
                result[i] = stack.pop()
        # Convert the result list back to a string and return
        return ''.join(result)
