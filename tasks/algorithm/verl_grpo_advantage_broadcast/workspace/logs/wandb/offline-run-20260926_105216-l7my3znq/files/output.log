def reverser(sentence):
    # Split the sentence into words and punctuation
    words_with_punctuation = punctuation_and_spaces = list(sentence)
    # Reverse each word in the list
    for i in range(len(words_with_punctuation)):
        # If it's a space or punctuation, replace the word (reverse processed) with it
        if words_with_punctuation[i].isspace() or words_with_punctuation[i].isalnum():
            words_with_punctuation[i] = words_with_punctuation[i][::-1]
    # Rejoin all words with punctuation into the final sentence
    final_sentence = ''.join(words_with_punctuation)
    return final_sentence
# Example usage:
