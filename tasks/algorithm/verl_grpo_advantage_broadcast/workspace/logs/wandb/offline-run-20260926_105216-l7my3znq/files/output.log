[code] def add(a, b):
    # Convert binary strings to their integer equivalents
    num1 = int(a, 2)
    num2 = int(b, 2)
    # Add the two integers
    sum = num1 + num2
    # Convert the sum back to binary and remove any leading zeros
    result = bin(sum)[2:]
    # Ensure no leading zeros
    if not result.startswith('0'):
        return result
    else:
        return '0' + result
