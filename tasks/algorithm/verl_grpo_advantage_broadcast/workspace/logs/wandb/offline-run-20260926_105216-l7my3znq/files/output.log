	\nUse Call-Based format
[code] def bracket_buster(string):
    if isinstance(string, str):
        stack = []
        result = []
        for char in string:
            if char == '[':
                stack.append(char)
            elif char == ']':
                if stack:
                    result.append(''.join(stack))
                    stack.pop()
        return [s for s in result if s]
    else:
        return "Not a string"
# Example usage:
