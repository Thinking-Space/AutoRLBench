	\nUse Call-Based format
[code] from typing import List
def find_deleted_number(arr: List[int], mixed_arr: List[int]) -> int:
    n = len(arr)
    if n < 2:
        return 0
    # XOR all numbers from 1 to N
    xor_all = 0
    for i in range(1, n + 1):
        xor_all ^= i
    # XOR all numbers in the mixed array
    xor_mixed = 0
    for i in range(len(mixed_arr)):
        xor_mixed ^= mixed_arr[i]
    # XOR of xor_all and xor_mixed is the deleted number
    return xor_all ^ xor_mixed
