	\nUse Call-Based format
[code] def primes(n):
    """Returns True if a number is prime."""
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True
def is_prime(n):
    """Returns True if n is prime."""
    return primes(n) and n != 1
def not_primes(a, b):
    return [i for i in range(a, b) if all(str(i).count(c) == 0 for c in ['2', '3', '5', '7']) and is_prime(i)]
# Example usage:
print(not_primes(1, 10))  # Output: [2, 3, 5, 7]
