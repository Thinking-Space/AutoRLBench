[code] def staircase(n):
    # Print the top triangle
    print(" " * (n - 1), end="")
    print("#" * n)
    # Print the middle triangle
    for i in range(n - 1, 0, -1):
        print(" " * (n - i), "#" * i)
# Example usage
staircase(4)
