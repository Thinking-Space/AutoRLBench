	\nUse Call-Based format
[code] from math import gcd
def solve(s,g):
    nums = []
    for i in range(1, s // g + 1):
        j = s - i
        if gcd(i, j) == g:
            nums.append(i)
            nums.append(j)
            break
    if not nums:
        return -1
    return sorted(nums)
