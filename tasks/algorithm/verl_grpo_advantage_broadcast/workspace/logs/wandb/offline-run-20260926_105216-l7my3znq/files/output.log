[code] class Solution:
    def isPowerOfAnother(self, X, Y):
        # Infinite loop until we find the power or X exceeds Y
        while X <= Y:
            # Reduce Y by the current X value
            Y = Y // X
            # Increase the power value
            X *= X
        # If X equals Y, then Y is a power of X
        return Y == X
