[code] def is_power_of_two(n):
    # A number is a power of two if it's a positive integer and it has exactly one bit set in its binary representation
    return (n > 0) and (n & (n - 1)) == 0
def find_subset_with_power_of_two_element(arr):
    # Check all possible non-empty subsets of the array
    for subset in [arr[i:j] for i in range(len(arr)) for j in range(i + 1, len(arr) + 1)]:
        # Calculate the bitwise AND of the current subset
        bit_and_result = 0
        for element in subset:
            bit_and_result &= element
        # Check if the result is a power of two
        if is_power_of_two(bit_and_result):
            return "YES"
    return "NO"
T = int(input().strip())
