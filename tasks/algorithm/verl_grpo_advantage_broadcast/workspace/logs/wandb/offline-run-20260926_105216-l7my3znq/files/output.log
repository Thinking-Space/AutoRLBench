[code] from collections import Counter
class Solution:
    def sameFreq(self, s):
        # Count the frequency of each character in the string
        freq_counter = Counter(s)
        # If there are at most two distinct characters, we can remove one to make all frequencies equal
        return len(freq_counter) <= 2
