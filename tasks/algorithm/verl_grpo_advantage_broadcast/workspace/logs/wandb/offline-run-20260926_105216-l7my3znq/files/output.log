[code] import re
def revamp(s):
    def _alphabetize(word):
        return ''.join(sorted(word))
    def _sum_ascii(word):
        return sum(ord(char) for char in word)
    # Split the string into words, alphabetize each word, and sum ASCII values
    words = re.findall(r'\w+', s)
    words = list(map(_alphabetize, words))
    words = list(map(lambda x: str(_sum_ascii(x)), words))
    words.sort()
    # Reconstruct the string
    return " ".join(words)
# Test the function with the provided examples
print(revamp("batman is bruce wayne"))  # Output: "is bceru aenwy aamntb"
