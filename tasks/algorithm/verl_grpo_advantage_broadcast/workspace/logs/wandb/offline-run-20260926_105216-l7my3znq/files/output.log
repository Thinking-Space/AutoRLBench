[code] def find_pattern(seq):
    seq_len = len(seq)
    found_pattern = []
    for i in range(1, seq_len):
        current_num = 1
        for j in range(1, i + 1):
            current_num += j
        if current_num == seq[i]:
            found_pattern.append(i)
    if len(found_pattern) > 0:
        return seq[:found_pattern[0]] * len(seq)
