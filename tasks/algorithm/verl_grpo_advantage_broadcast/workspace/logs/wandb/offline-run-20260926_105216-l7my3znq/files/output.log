[code] class Solution:
    def find(self, A, B):
        # Formula to calculate the least common multiple (LCM) of A and B
        lcm = (A * B) // math.gcd(A, B)
        # Find the next multiple of B greater than A
        next_multiple = lcm + B - 1
        return next_multiple
