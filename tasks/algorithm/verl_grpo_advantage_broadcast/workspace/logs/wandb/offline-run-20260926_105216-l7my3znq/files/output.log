[code] def case_sensitive(s):
    # Initialize result variables
    is_all_lowercase = all(char.islower() for char in s)
    non_lowercase_list = []
    # Check each character in the string
    for char in s:
        if char.islower():
            is_all_lowercase = False
            non_lowercase_list.append(char)
    return is_all_lowercase, non_lowercase_list
