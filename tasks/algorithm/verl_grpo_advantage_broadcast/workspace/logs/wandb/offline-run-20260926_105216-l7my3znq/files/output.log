[code] class Solution:
    def chartostr(self, arr, N):
        # Initialize an empty string to store the merged characters
        merged_string = ""
        # Loop through the array and append each character to the merged_string
        for i in range(N):
            merged_string += arr[i]
        # Return the merged_string as a string
        return merged_string
