[code] class Solution:
    def sentencePalindrome(self, s):
        # Remove white spaces and convert to lowercase
        cleaned_s = ''.join(s.split()).lower()
        length = len(cleaned_s)
        # Compare characters from the beginning and the end, moving towards the center
        for i in range(length // 2):
            if cleaned_s[i] != cleaned_s[length - i - 1]:
                return 0
        return 1
