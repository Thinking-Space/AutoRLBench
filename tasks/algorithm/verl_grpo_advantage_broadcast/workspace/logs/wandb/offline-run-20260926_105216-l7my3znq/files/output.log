-----Input-----
Input will consist of a single integer N (1 ≤ N ≤ 10^6), the number of city blocks that must be enclosed by the route.
-----Output-----
Print the minimum perimeter that can be achieved.
-----Examples-----
Input
4
Output
8
...[+144 chars]
[code] import math
# Function to calculate the minimum perimeter of a rectangle enclosing N city blocks
def min_perimeter(N):
    # Calculate the factors of N
    factors = []
    for i in range(1, int(math.sqrt(N)) + 1):
        if N % i == 0:
            factors.append(i)
            factors.append(N // i)
    # Remove duplicates and sort the factors
    unique_factors = sorted(set(factors))
    # Calculate the perimeter for each pair of factors
    perimeters = [2 * (a + b) for a, b in zip(unique_factors, unique_factors[1:])]
    # Return the minimum perimeter
    return min(perimeters)
# Input the value of N
N = int(input())
# Print the minimum perimeter
print(min_perimeter(N))
