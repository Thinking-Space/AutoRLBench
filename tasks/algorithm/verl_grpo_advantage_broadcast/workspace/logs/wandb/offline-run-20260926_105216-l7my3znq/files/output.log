import math
def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    if n == 2 or n == 3:  # 2 and 3 are prime
        return True
    if n % 2 == 0 or n % 3 == 0:  # Exclude even numbers and multiples of 3
        return False
    i = 5
    w = 8
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += w
        w = 6 - w
    return True
def summationOfPrimes(n):
    """Sum all prime numbers up to and including `n`."""
    prime_sum = 0
    for i in range(2, n + 1):
        if is_prime(i):
            prime_sum += i
    return prime_sum
# Example usage:
