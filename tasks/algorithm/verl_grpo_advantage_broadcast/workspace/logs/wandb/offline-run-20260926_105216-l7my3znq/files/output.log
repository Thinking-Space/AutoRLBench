[code] class Solution:
    def printEqualModNumbers(self, arr, n):
        # Check for strict divisibility with any divisor other than 1 and -1
        not_divisible_by_1 = [i for i in arr if i % 2 != 0]
        not_divisible_by_neg = [i for i in arr if i % 3 != 0]
        # Total numbers count will always be even
        total_numbers = len(arr)
        count = 2 * total_numbers
        min_value = min(not_divisible_by_1 + not_divisible_by_neg)
        # Sum of the numbers where each number is added twice
        result = sum(2 * v for v in arr)
        # Return the result, -1 if no such values found
        if count <= 0:
            return -1
        else:
            return min_value + result
# Example usage:
