[code] import math
def find_factors_natural(n):
    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            return i, n // i
    return n, 1
def find_key_hex(key):
    # Convert hexadecimal to decimal
    decimal_key = int(key, 16)
    # Find the prime factors
    factor1, factor2 = find_factors_natural(decimal_key)
    # Compute (P-1)*(Q-1)
    product = (factor1 - 1) * (factor2 - 1)
    return product
# Examples
