[code] from math import isqrt
class Solution:
    def prime_Sum(self, n):
        def is_prime(num):
            if num < 2:
                return False
            for i in range(2, isqrt(num) + 1):
                if num % i == 0:
                    return False
            return True
        return sum(i for i in range(2, n+1) if is_prime(i))
