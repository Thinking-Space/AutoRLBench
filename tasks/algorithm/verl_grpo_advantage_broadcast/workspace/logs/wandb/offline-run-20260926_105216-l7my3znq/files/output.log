def minOps(a, n):
    operations = 0
    while not all(a[i] == i + 1 for i in range(n)):
        next_a = sorted(a)
        dq = deque(a)
        # Move smaller elements to the front
        while dq and dq[0] < next_a[0]:
            operations += 1
            dq.appendleft(dq.pop())
        operations += len(dq)
        # Restore elements in correct order
        for i in range(n):
            dq[i] = next_a[i]
        a = list(dq)
    return operations
