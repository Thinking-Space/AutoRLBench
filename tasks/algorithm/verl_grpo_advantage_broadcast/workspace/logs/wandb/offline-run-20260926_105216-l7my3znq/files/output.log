    sorted_chars = sorted(string)
    # Step 3: Combine the sorted characters into sequences
    sequences = []
    current_sequence = sorted_chars[0]
    for i in range(1, len(sorted_chars)):
        if sorted_chars[i].lower() <= sorted_chars[i-1].lower():
            current_sequence += sorted_chars[i]
        else:
            sequences.append(current_sequence)
            current_sequence = sorted_chars[i]
    # Append the last sequence
    sequences.append(current_sequence)
    # Step 4: Combine the sequences with commas
    result = ','.join(sequences)
    return result
# Test the function with the provided example
print(alpha_seq("ZpglnRxqenU"))  # Output: "Eeeee,Ggggggg,Llllllllllll,Nnnnnnnnnnnnnn,Nnnnnnnnnnnnnn,Pppppppppppppppp,Qqqqqqqqqqqqqqqqq,Rrrrrrrrrrrrrrrrrr,Uuuuuuuuuuuuuuuuuuuuu,Xxxxxxxxxxxxxxxxxxxxxxxx,Zzzzzzzzzzzzzzzzzzzzzzzzzz"
