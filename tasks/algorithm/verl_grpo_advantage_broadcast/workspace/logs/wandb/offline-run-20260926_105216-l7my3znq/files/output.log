def removeDuplicates(head):
    if not head or not head.next:
        return head
    cur = head
    while cur.next:
        if cur.data == cur.next.data:
            next_node = cur.next.next
            cur.next = None
            cur.next = next_node
        else:
            cur = cur.next
    return head
