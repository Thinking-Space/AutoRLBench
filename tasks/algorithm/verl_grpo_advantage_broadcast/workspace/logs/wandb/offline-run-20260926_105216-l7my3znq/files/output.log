# No libraries are needed for this problem
def find_max_sum(n, nums):
    # Initialize the array to store the maximum sum ending at each index
    dp = [0] * n
    # Set a variable to store the maximum sum found so far
    max_sum_so_far = float('-inf')
    # Iterate through the array
    for i in range(n):
        # Update the current maximum sum by comparing the previous optimal sum and the current element
        dp[i] = max(dp[i-1] + nums[i], nums[i])
        # Update the maximum sum found so far if a new maximum is found
        max_sum_so_far = max(max_sum_so_far, dp[i])
