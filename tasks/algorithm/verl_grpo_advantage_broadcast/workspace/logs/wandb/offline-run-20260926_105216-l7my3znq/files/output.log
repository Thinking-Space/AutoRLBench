[code] def odd_row(n):
    # Initialize the row with the first number, which is 1
    row = [1]
    # Calculate the next row based on the previous row
    for _ in range(n - 1):
        # Add the next two odd numbers to the current row
        row += [sum(row[-2:]) + (2 * len(row) + 1) // 2]
    return row
