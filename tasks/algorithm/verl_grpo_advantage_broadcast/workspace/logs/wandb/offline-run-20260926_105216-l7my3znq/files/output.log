    def removeChars(self, string1: str, string2: str) -> str:
        result = []
        # Iterate over each character in string1
        for char in string1:
            # If the character is not in string2, add it to the result
            if char not in string2:
                result.append(char)
        # Join the characters in the result list to form the final string
        return ''.join(result)
