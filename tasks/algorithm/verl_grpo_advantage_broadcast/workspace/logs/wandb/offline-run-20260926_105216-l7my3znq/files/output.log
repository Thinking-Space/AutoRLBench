[question] QUESTION:
Count the number of segments in a string, where a segment is defined to be a contiguous sequence of non-space characters.
Please note that the string does not contain any non-printable characters.
Example:
Input: "Hello, my name is John"
Output: 5 class Solution:
    def countSegments(self, s: str) -> int:
        \nUse Call-Based format
[code] # Define the class Solution
class Solution:
    def countSegments(self, s: str) -> int:
        # Initialize the count of segments to 0
        count = 0
        # Initialize the flag to track if the current segment starts a new word
        start_new_segment = False
        # Iterate through the string
        for char in s:
            # If the character is not a space, it starts a new segment
            if char != ' ':
                # Reset the flag to track the start of a new segment
                start_new_segment = True
            # If it's the start of a new segment and the current character is not a space, increment the segment count
            elif start_new_segment and char != ' ':
                count += 1
                # Reset the flag to track the start of a new segment after processing the current character
                start_new_segment = False
        # Return the total number of segments
        return count
