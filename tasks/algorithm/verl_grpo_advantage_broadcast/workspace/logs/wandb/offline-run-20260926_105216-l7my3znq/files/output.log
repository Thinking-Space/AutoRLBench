[code] from collections import Counter
class Solution:
    def longestPalindrome(self, s: str) -> int:
        # Count the frequency of each character in the string
        char_count = Counter(s)
        # Initialize the length of the longest palindrome
        palindrome_length = 0
        # Initially include characters that appear an even number of times
        palindrome_length += max(0, len(s) - sum(ch % 2 for ch in char_count))
        # Check characters that appear an odd number of times
        for char, count in char_count.items():
            if count % 2 == 1:
                palindrome_length += 1
        return palindrome_length
