[code] class Solution:
    def findMaxSum(self, arr, n):
        # Initialize the end and last elements of the array
        end, last = arr[0], max(arr[0], 0)
        # Iterate through the array starting from the second element
        for i in range(1, n):
            # Calculate the maximum subsequence sum without including the current element
            tmp = max(last, arr[i])
            # Update last to be the maximum of the current position's element and the sum including the current position's element
            last, end = max(arr[i] + end, tmp), tmp
        # Return the maximum of the final position's element and the sum including the final position's element
        return max(arr[n-1], end)
