[code] import math
def year_to_target_deposit(x):
    """
    Calculate the number of years it takes for Takahashi's balance to reach X yen or above for the first time.
    :param x: Target balance in yen.
    :return: Number of years to reach the target balance.
    """
    # The exact number of years needed to reach the target is the ceiling of ln(x) / ln(1.01)
    return math.ceil(math.log(x) / math.log(1.01))
# Input
