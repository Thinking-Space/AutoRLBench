# Calculate the side length of the largest square that can fit inside a circle
# The side length of the largest square = diameter/2 * sin(pi/4) = (2r)/2 * sqrt(2)/2 = r * sqrt(2)
def area_largest_square(r):
    side_length = 2 * r * math.sqrt(2) / 2
    area = side_length ** 2
    return area
