[code] def convert_miles_to_litre(mpg):
    inch_in_mile = 1.609344  # Inches in a mile
    liter_in_imperial_gallon = 4.54609188  # Litres in an imperial gallon
    # Convert miles to kilometres
    kilometres_per_mile = inch_in_mile * 1.609344
    # Convert mpg to liters per kilometre
    liters_per_kilometre = (mpg / kilometres_per_mile) * liter_in_imperial_gallon
    # Round to two decimal points
    return round(liters_per_kilometre, 2)
