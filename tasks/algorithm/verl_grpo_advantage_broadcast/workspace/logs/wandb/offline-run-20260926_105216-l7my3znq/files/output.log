[code] import math
from functools import reduce
def lcm(*args):
    # If there are no arguments, return 1
    if not args:
        return 1
    # Start with the first argument as the initial LCM
    lcm_value = math.gcd(args[0], args[1])
    # Compute the LCM for all arguments using the initial value and GCD
    for arg in args[2:]:
        lcm_value = math.gcd(lcm_value, arg)
    return lcm_value
# Example usage:
print(lcm(4, 5, 6))  # Output: 60
print(lcm(12, 15, 20))  # Output: 60
print(lcm())  # Output: 1
