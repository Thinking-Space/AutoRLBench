[code] from collections import Counter
import heapq
def solve(arr):
    # Count the frequency of each element
    frequency = Counter(arr)
    # Extract elements and their frequencies as a list of (element, frequency) tuples
    elements = sorted([(freq, element) for element, freq in frequency.items()])
    # Use a max heap to sort elements first by frequency in descending order
    # Then, for elements with the same frequency, by increasing value
    return heapq.nlargest(len(arr), elements)
