[code] import math
def calculate_volume(r):
    # Volume of a cylinder: V = πr^2h
    # Volume of a cone: V = (1/3)πr^2h
    # Since the height \( h \) is a constant (equal to 1 for simplicity),
    # the volume of the cylinder is given by: V_cylinder = πr^2
    # The volume of the cone is given by: V_cone = (1/3)πr^2
    volume_cylinder = math.pi * r**2
    volume_cone = (1/3) * math.pi * r**2
    return volume_cylinder + volume_cone
max_radius = 100
cumulative_volume = sum(calculate_volume(r) for r in range(1, max_radius + 1))
print(round(cumulative_volume))
