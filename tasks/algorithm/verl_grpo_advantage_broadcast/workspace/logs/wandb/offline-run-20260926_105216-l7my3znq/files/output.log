[code] # Import necessary packages
# (In this case, no external packages are needed)
def is_valid(idn):
    # Check if the string is not empty
    if not idn:
        return False
    # Check if the first character is a valid identifier character
    if idn[0].isdigit():
        return False
    if not idn[0].isidentifier():
        return False
    # Check if all remaining characters are valid identifier characters
    for char in idn[1:]:
        if not (char.isalpha() or char.isdigit() or char.isidentifier() or char == '_'):
            return False
    return True
# Example usage:
