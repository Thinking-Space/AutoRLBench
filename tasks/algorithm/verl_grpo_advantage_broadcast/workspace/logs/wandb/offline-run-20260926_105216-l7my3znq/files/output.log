[code] # Write your code here
class Solution:
    def searchInsert(self, nums: List[int], target: int) -> int:
        # Iterate through the list to find the insertion point
        for i, num in enumerate(nums):
            # Return the index if target is found
            if num == target:
                return i
            # If target is larger than any element, return the next index in the list
            elif target > num:
                return i
