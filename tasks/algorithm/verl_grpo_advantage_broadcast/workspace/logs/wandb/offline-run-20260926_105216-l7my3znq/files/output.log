1 ≤ A, B ≤ 10^{9} #User function Template for python3
class Solution:
    def gcd(self, A, B):
        # code here\nUse Call-Based format
[code] # Use Call-Based format
class Solution:
    def gcd(self, A, B):
        # Base case: if B is 0, A is the GCD
        while B:
            A, B = B, A % B
        return A
