[code] from functools import reduce
# Define the function to find common items between two lists
def find_common_items(strings1, strings2):
    if len(strings1) != len(strings2):
        return False
    return list(filter(lambda x: reduce(lambda k, v: k.union(v), [x for s in [strings1, strings2] for x in s]), strings1))[0]
# Define the Solution class
class Solution:
    def is_common(self, firstMenu, secondMenu):
        # Find common items between the two menus
        common_items = find_common_items(firstMenu.split(), secondMenu.split())
        # If no common items, return "BEHAPPY"
        return "BEHAPPY" if common_items == "" else "CHANGE"
