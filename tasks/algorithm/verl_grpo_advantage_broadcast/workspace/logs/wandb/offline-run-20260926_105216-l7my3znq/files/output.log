[code] from math import gcd
class Solution:
    def findXandY(self, A, B, N):
        g = gcd(A, B)  # Calculate the greatest common divisor (gcd) of A and B
        x = N // g / A  # Calculate x
        y = N // g / B  # Calculate y
        # If x or y is negative or results in non-integer, set them to -1
        for i in [x, y]:
            if i < 0 or i.is_integer() != True:  # Check for non-positive values or non-integer
                x, y = -1, -1  # Return -1 -1 if any value is invalid
                break
        return [x, y]  # Return the valid solution as a list
