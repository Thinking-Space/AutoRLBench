	def divisibleBy11(self, S):
		# Your Code Here\nUse Call-Based format
[code] class Solution:
    def divisibleBy11(self, S):
        # Calculate the alternating sum of the digits
        alt_sum = sum(int(S[i]) if i % 2 == 0 else -int(S[i]) for i in range(len(S)))
        # Check if the alternating sum is divisible by 11
        return alt_sum % 11 == 0
