[code] from itertools import permutations
class Solution:
    def findNext(self, n):
        # Convert the number to a set of digits
        digits = set(str(n))
        # Generate all possible permutations of the digits, sorted in ascending order
        for perm in sorted(set(permutations(digits)), key=int):
            # Skip permutations that are duplicates of any previously considered permutation
            if perm > n:
                return int(''.join(perm))
        return -1
