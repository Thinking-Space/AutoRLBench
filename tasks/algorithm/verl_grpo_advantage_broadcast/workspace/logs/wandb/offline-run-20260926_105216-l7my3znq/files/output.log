[code] import re
def date_checker(date):
    # Define the regex pattern to match the date format
    pattern = r'^([01]\d-|2[0-3])(-|:)([0-2]\d|3[01])(-|:)([0-5]\d)$'
    # Use the fullmatch method to check if the entire string matches the pattern
    if re.fullmatch(pattern, date):
        return True
    else:
        return False
