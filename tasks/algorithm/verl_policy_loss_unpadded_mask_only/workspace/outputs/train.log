[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \left( \frac{9}{s + 2} + \frac{t}{60} \right) - \left( \frac{9}{s} + \frac{t}{60} \right) = 2.4 - 4
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Simplify:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{9}{s + 2} - \frac{9}{s} = -1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Factor out 9:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 9 \left( \frac{1}{s + 2} - \frac{1}{s} \right) = -1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Compute the difference of fractions:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{1}{s + 2} - \frac{1}{s} = \frac{s - (s + 2)}{s(s + 2)} = \frac{-2}{s(s + 2)}
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m So:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 9 \cdot \left( \frac{-2}{s(s + 2)} \right) = -1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{-18}{s(s + 2)} = -1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Multiply both sides by -1:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{18}{s(s + 2)} = 1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Now solve for $ s $:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m s(s + 2) = \frac{18}{1.6} = 11.25
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m So:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m s^2 + 2s - 11.25 = 0
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Solve this quadratic equation:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
