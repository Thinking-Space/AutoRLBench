[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m So:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 9 \cdot \frac{2}{s(s + 2)} = 1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{18}{s(s + 2)} = 1.6
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Multiply both sides by $ s(s + 2) $:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 18 = 1.6s(s + 2)
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Divide both sides by 1.6:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{18}{1.6} = s(s + 2)
