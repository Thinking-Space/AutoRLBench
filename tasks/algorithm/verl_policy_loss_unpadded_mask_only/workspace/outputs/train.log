[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m \frac{t}{60} = 0.4
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m t = 0.4 \times 60 = 24 \text{ minutes}
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m ---
