[36m(TaskRunner pid=25105)[0m 1.6s^2 + 3.2s - 9s - 18 = -9s
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 1.6s^2 - 5.8s - 18 = -9s
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Add 9s to both sides:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 1.6s^2 + 3.2s - 18 = 0
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Multiply through by 10 to eliminate decimals:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 16s^2 + 32s - 180 = 0
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m ---
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m ### **Step 6: Solve the quadratic equation**
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 16s^2 + 32s - 180 = 0
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Divide through by 4:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 4s^2 + 8s - 45 = 0
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m Use the quadratic formula:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m s = \frac{-8 \pm \sqrt{8^2 - 4(4)(-45)}}{2(4)} = \frac{-8 \pm \sqrt{64 + 720}}{8} = \frac{-8 \pm \sqrt{784}}{8}
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m s = \frac{-8 \pm 28}{8}
[36m(TaskRunner pid=25105)[0m $$
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m So:
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m - $ s = \frac{-8 + 28}{8} = \frac{20}{8} = 2.5 $
[36m(TaskRunner pid=25105)[0m - $ s = \frac{-8 - 28}{8} = \frac{-36}{8} = -4.5 $ (discard negative speed)
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m So, $ s = 2.5 $ km/h
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m ---
[36m(TaskRunner pid=25105)[0m 
[36m(TaskRunner pid=25105)[0m ### **Step 7: Find the time at speed $ s + \frac{1}{2} = 2.5 + 0.5 = 3 $ km/h**
