[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m BD^2 = 80 + 0 = 80
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
