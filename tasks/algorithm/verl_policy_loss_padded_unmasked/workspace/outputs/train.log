[36m(TaskRunner pid=13888)[0m \Rightarrow 156 = 36 + (s - a)^2
[36m(TaskRunner pid=13888)[0m \Rightarrow (s - a)^2 = 120
[36m(TaskRunner pid=13888)[0m \Rightarrow s - a = \sqrt{120} = 2\sqrt{30}
[36m(TaskRunner pid=13888)[0m $$
