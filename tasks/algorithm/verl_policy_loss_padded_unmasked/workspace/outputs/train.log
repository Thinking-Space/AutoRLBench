[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m IA = \sqrt{r^2 + \left( s - a \right)^2}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Similarly:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m IO = \sqrt{r^2 + \left( s - b \right)^2}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m But since $IA \perp OI$, we have:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m IA^2 + OI^2 = AO^2 = 169
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m \left( r^2 + (s - a)^2 \right) + \left( r^2 + (s - b)^2 \right) = 169
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 2r^2 + (s - a)^2 + (s - b)^2 = 169
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Substitute $r = 6$:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 2(36) + (s - a)^2 + (s - b)^2 = 169
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 72 + (s - a)^2 + (s - b)^2 = 169
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m (s - a)^2 + (s - b)^2 = 97 \tag{17}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Now, expand the left-hand side:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m (s - a)^2 + (s - b)^2 = s^2 - 2as + a^2 + s^2 - 2bs + b^2 = 2s^2 - 2s(a + b) + a^2 + b^2
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 2s^2 - 2s(a + b) + a^2 + b^2 = 97 \tag{18}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m But we also know that:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m a^2 + b^2 = 169 \tag{2}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 2s^2 - 2s(a + b) + 169 = 97
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 2s^2 - 2s(a + b) = -2 \tag{19}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m s^2 - s(a + b) = -1 \tag{20}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Now, we need to find $a + b$.
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m From earlier, we had:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m bc = s \Rightarrow a + b = \frac{abc}{bc} = \frac{312s}{s} = 312 \tag{21}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m a + b = 312 \tag{22}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Substitute into equation (20):
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m s^2 - s(312) = -1 \Rightarrow s^2 - 312s + 1 = 0 \tag{23}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Solve this quadratic equation:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m s = \frac{312 \pm \sqrt{312^2 - 4 \cdot 1 \cdot 1}}{2} = \frac{312 \pm \sqrt{9700 - 4}}{2} = \frac{312 \pm \sqrt{964}}{2}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m s = \frac{312 \pm 31.32}{2}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m s = \frac{312 + 31.32}{2} = 171.6 \quad \text{or} \quad s = \frac{312 - 31.32}{2} = 140.4
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Since $s$ must be positive, both are valid, but we need to choose the correct one.
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m From earlier, we had:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m bc = s \Rightarrow AB \cdot AC = s
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So the answer is:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m \boxed{156}
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
