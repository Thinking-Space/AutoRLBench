[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Substitute into equation (2):
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 9 = \left( \frac{9}{4 - x} + 2 \right)(2.4 - x)
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Multiply out:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 9 = \left( \frac{9 + 2(4 - x)}{4 - x} \right)(2.4 - x)
