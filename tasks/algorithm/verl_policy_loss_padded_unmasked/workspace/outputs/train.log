[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Now multiply both sides by $ 4 - x $:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 9(4 - x) = (17 - 2x)(2.4 - x)
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Expand the right-hand side:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m (17 - 2x)(2.4 - x) = 17 \cdot 2.4 - 17x - 4.8x + 2x^2
[36m(TaskRunner pid=13888)[0m = 40.8 - 21.8x + 2x^2
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m So:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 36 - 9x = 40.8 - 21.8x + 2x^2
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Bring all terms to one side:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 2x^2 - 21.8x + 40.8 - 36 + 9x = 0
[36m(TaskRunner pid=13888)[0m \Rightarrow 2x^2 - 12.8x + 4.8 = 0
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m Multiply through by 10 to eliminate decimals:
[36m(TaskRunner pid=13888)[0m 
[36m(TaskRunner pid=13888)[0m $$
[36m(TaskRunner pid=13888)[0m 20x^2 - 128x + 48 = 0
