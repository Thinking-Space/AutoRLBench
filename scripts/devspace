#!/usr/bin/env bash
#
# Portable Cybertron DevSpace driver.
#
# Copy this file into a project as `scripts/devspace`, then drive a remote
# devspace entirely from the terminal:
#
#   scripts/devspace use latest              # pick newest running devspace
#   scripts/devspace sync                    # rsync tracked+untracked (honors .devspaceignore)
#   scripts/devspace run -- python train.py  # sync then run, live stdout
#   scripts/devspace tmux                     # sync then attach a persistent session
#   scripts/devspace pull results            # download a remote subdir
#
# Per-repo state lives in ./.devspace.local (0600, gitignore it). Rsync excludes
# come from ./.devspaceignore. Override the two defaults below per project via
# env (DEVSPACE_DEFAULT_DIR / DEVSPACE_DEFAULT_PROJECT) or the `use` arguments.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
CONFIG_FILE="$REPO_ROOT/.devspace.local"
IGNORE_FILE="$REPO_ROOT/.devspaceignore"
SSH_CONFIG=${DEVSPACE_SSH_CONFIG:-"$HOME/.ssh/config"}
CONTROL_PATH="$HOME/.ssh/devspace-%C"
# Per-project defaults — override via env or the `use <id> <remote_dir>` args.
DEFAULT_REMOTE_DIR=${DEVSPACE_DEFAULT_DIR:-/user/$USER/workspaces/$(basename "$REPO_ROOT")}
DEFAULT_PROJECT=${DEVSPACE_DEFAULT_PROJECT:-}

SSH_OPTIONS=(
  -o ControlMaster=auto
  -o ControlPersist=10m
  -o "ControlPath=$CONTROL_PATH"
  -o ServerAliveInterval=30
  -o ServerAliveCountMax=3
)

usage() {
  cat <<'EOF'
Usage:
  scripts/devspace targets
  scripts/devspace use <ID|SSH_HOST|latest> [REMOTE_DIR]
  scripts/devspace current
  scripts/devspace sync [--dry-run]
  scripts/devspace pull <REMOTE_PATH>
  scripts/devspace run -- <COMMAND> [ARG...]
  scripts/devspace shell
  scripts/devspace tmux [SESSION]

Commands:
  targets  List running devspaces and SSH hosts generated by the Cursor plugin.
  use      Validate and save the current devspace. "latest" selects the newest
           running devspace in DEVSPACE_PROJECT.
  current  Show the selected SSH host, remote directory, and cctl status.
  sync     Upload tracked and non-ignored files with rsync. Remote-only files
           are preserved. Use --dry-run to preview changes.
  pull     Incrementally download a relative directory from the remote
           repository to the same local path. Local-only files are preserved.
  run      Sync, then execute a command remotely with live stdout/stderr.
  shell    Sync, then open a login shell in the remote repository.
  tmux     Sync, then create or attach to a persistent tmux session.
EOF
}

die() {
  printf 'devspace: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || die "no target selected; run: scripts/devspace use <ID|SSH_HOST|latest>"
  # This file is local, mode 0600, and only written by the use command.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  : "${DEVSPACE_ID:?missing DEVSPACE_ID in $CONFIG_FILE}"
  : "${DEVSPACE_HOST:?missing DEVSPACE_HOST in $CONFIG_FILE}"
  : "${DEVSPACE_DIR:?missing DEVSPACE_DIR in $CONFIG_FILE}"
  DEVSPACE_PROJECT=${DEVSPACE_PROJECT:-$DEFAULT_PROJECT}
}

validate_host() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid SSH host: $1"
}

validate_id() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "invalid devspace ID: $1"
}

validate_remote_dir() {
  [[ "$1" == /* ]] || die "remote directory must be absolute: $1"
  [[ "$1" != *$'\n'* ]] || die "remote directory must not contain newlines"
}

validate_pull_path() {
  local path=$1
  [[ -n "$path" ]] || die "pull path must not be empty"
  [[ "$path" != /* ]] || die "pull path must be relative to the remote repository: $path"
  [[ "$path" != *$'\n'* ]] || die "pull path must not contain newlines"
  [[ "$path" != *//* ]] || die "pull path must not contain empty components: $path"
  case "/$path/" in
    */../*|*/./*) die "pull path must not contain . or .. components: $path" ;;
  esac
}

ensure_local_pull_path() {
  local path=$1 current=$REPO_ROOT component
  local -a components
  IFS=/ read -r -a components <<<"$path"
  for component in "${components[@]}"; do
    current="$current/$component"
    [[ ! -L "$current" ]] || die "pull path contains a local symbolic link: $path"
  done
}

shell_quote() {
  printf '%q' "$1"
}

ssh_exec() {
  ssh "${SSH_OPTIONS[@]}" "$DEVSPACE_HOST" "$@"
}

configured_hosts() {
  [[ -r "$SSH_CONFIG" ]] || return 0
  awk '
    /^[[:space:]]*Host[[:space:]]+/ {
      for (i = 2; i <= NF; i++) {
        if ($i ~ /^devspace-/ && $i !~ /[*?!]/) print $i
      }
    }
  ' "$SSH_CONFIG" | sort -u
}

host_for_id() {
  local id=$1
  local matches
  matches=$(configured_hosts | awk -v suffix="-$id" 'substr($0, length($0) - length(suffix) + 1) == suffix')
  local count
  count=$(printf '%s\n' "$matches" | awk 'NF { count++ } END { print count + 0 }')
  [[ "$count" -gt 0 ]] || die "no SSH Host ending in -$id; refresh the Cursor Cybertron/Teleport SSH configuration"
  [[ "$count" -eq 1 ]] || die "multiple SSH hosts match ID $id; pass the full SSH Host name"
  printf '%s\n' "$matches"
}

latest_running_id() {
  local project=$1
  require_command cctl
  require_command python3
  local list_args=(devspace list --own --status Running -o json)
  [[ -n "$project" ]] && list_args+=(--project "$project")
  cctl "${list_args[@]}" |
    python3 -c 'import json, sys
tasks = json.load(sys.stdin).get("tasks", [])
if not tasks:
    raise SystemExit("no running devspace found")
task = max(tasks, key=lambda item: item.get("createTime", ""))
print(str(task["name"]).rsplit("/", 1)[-1])'
}

devspace_status() {
  local id=$1
  require_command cctl
  require_command python3
  cctl devspace get "$id" -F status |
    python3 -c 'import json, sys; print(json.load(sys.stdin)["status"])'
}

save_config() {
  local id=$1 host=$2 remote_dir=$3 project=$4
  local tmp="$CONFIG_FILE.tmp.$$"
  umask 077
  {
    printf 'DEVSPACE_ID=%q\n' "$id"
    printf 'DEVSPACE_HOST=%q\n' "$host"
    printf 'DEVSPACE_DIR=%q\n' "$remote_dir"
    printf 'DEVSPACE_PROJECT=%q\n' "$project"
  } >"$tmp"
  mv "$tmp" "$CONFIG_FILE"
}

select_target() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: scripts/devspace use <ID|SSH_HOST|latest> [REMOTE_DIR]"
  local target=$1
  local remote_dir=${2:-$DEFAULT_REMOTE_DIR}
  local project=$DEFAULT_PROJECT
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    project=${DEVSPACE_PROJECT:-$DEFAULT_PROJECT}
  fi

  local id host
  if [[ "$target" == latest ]]; then
    id=$(latest_running_id "$project")
    host=$(host_for_id "$id")
  elif [[ "$target" =~ ^[0-9]+$ ]]; then
    id=$target
    host=$(host_for_id "$id")
  else
    host=$target
    id=${host##*-}
    validate_id "$id"
  fi

  validate_id "$id"
  validate_host "$host"
  validate_remote_dir "$remote_dir"

  local status
  status=$(devspace_status "$id")
  [[ "$status" == Running || "$status" == Started ]] || die "devspace $id is not running (status: $status)"

  ssh "${SSH_OPTIONS[@]}" -o BatchMode=yes -o ConnectTimeout=10 "$host" true ||
    die "SSH validation failed for $host; refresh the Teleport login or Cursor SSH configuration"

  save_config "$id" "$host" "$remote_dir" "$project"
  printf 'Selected devspace %s\nSSH host: %s\nRemote dir: %s\n' "$id" "$host" "$remote_dir"
}

show_targets() {
  printf 'Configured SSH devspace hosts:\n'
  configured_hosts | sed 's/^/  /'
  printf '\nRunning devspaces:\n'
  require_command cctl
  cctl devspace list --own --status Running
}

show_current() {
  load_config
  printf 'Devspace:  %s\nSSH host:  %s\nRemote dir: %s\nProject:   %s\n\n' \
    "$DEVSPACE_ID" "$DEVSPACE_HOST" "$DEVSPACE_DIR" "$DEVSPACE_PROJECT"
  require_command cctl
  cctl devspace get "$DEVSPACE_ID" -F status,cluster,project,updateTime
}

sync_files() {
  local dry_run=${1:-false}
  load_config
  require_command git
  require_command rsync
  require_command ssh
  [[ -r "$IGNORE_FILE" ]] || die "missing $IGNORE_FILE"

  local remote_dir_q
  remote_dir_q=$(shell_quote "$DEVSPACE_DIR")
  ssh_exec "mkdir -p $remote_dir_q"

  local rsync_ssh
  rsync_ssh="ssh -o ControlMaster=auto -o ControlPersist=10m -o ControlPath=$CONTROL_PATH -o ServerAliveInterval=30 -o ServerAliveCountMax=3"
  local args=(-azrR --from0 --files-from=- --exclude-from="$IGNORE_FILE" --partial --itemize-changes)
  if [[ "$dry_run" == true ]]; then
    args+=(--dry-run)
  fi

  (
    cd "$REPO_ROOT"
    git ls-files -co --exclude-standard --exclude-from="$IGNORE_FILE" -z |
      rsync "${args[@]}" -e "$rsync_ssh" ./ "$DEVSPACE_HOST:$DEVSPACE_DIR/"
  )
}

pull_files() {
  [[ $# -eq 1 ]] || die "usage: scripts/devspace pull <REMOTE_PATH>"
  local path=${1%/}
  validate_pull_path "$path"
  ensure_local_pull_path "$path"
  load_config
  require_command rsync
  require_command ssh

  local local_path="$REPO_ROOT/$path"
  mkdir -p "$local_path"

  local remote_path_q
  remote_path_q=$(shell_quote "$DEVSPACE_DIR/$path/")
  local rsync_ssh
  rsync_ssh="ssh -o ControlMaster=auto -o ControlPersist=10m -o ControlPath=$CONTROL_PATH -o ServerAliveInterval=30 -o ServerAliveCountMax=3"
  rsync -az --partial --itemize-changes -e "$rsync_ssh" \
    "$DEVSPACE_HOST:$remote_path_q" "$local_path/"
}

run_remote() {
  [[ $# -gt 0 ]] || die "run requires a command"
  [[ "$1" == -- ]] && shift
  [[ $# -gt 0 ]] || die "run requires a command"
  sync_files false

  local remote_dir_q command_q='' arg_q
  remote_dir_q=$(shell_quote "$DEVSPACE_DIR")
  for arg in "$@"; do
    arg_q=$(shell_quote "$arg")
    command_q+=" $arg_q"
  done
  ssh "${SSH_OPTIONS[@]}" -tt "$DEVSPACE_HOST" \
    "cd $remote_dir_q && export PYTHONUNBUFFERED=1 && exec$command_q"
}

open_shell() {
  sync_files false
  local remote_dir_q
  remote_dir_q=$(shell_quote "$DEVSPACE_DIR")
  ssh "${SSH_OPTIONS[@]}" -tt "$DEVSPACE_HOST" "cd $remote_dir_q && exec bash -l"
}

open_tmux() {
  local session=${1:-devspace}
  [[ "$session" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid tmux session name: $session"
  sync_files false
  local remote_dir_q session_q
  remote_dir_q=$(shell_quote "$DEVSPACE_DIR")
  session_q=$(shell_quote "$session")
  ssh "${SSH_OPTIONS[@]}" -tt "$DEVSPACE_HOST" \
    "cd $remote_dir_q && exec tmux new-session -A -s $session_q"
}

main() {
  local command=${1:-help}
  [[ $# -eq 0 ]] || shift
  case "$command" in
    targets) show_targets "$@" ;;
    use) select_target "$@" ;;
    current|status) show_current "$@" ;;
    sync)
      if [[ ${1:-} == --dry-run ]]; then
        sync_files true
      elif [[ $# -eq 0 ]]; then
        sync_files false
      else
        die "usage: scripts/devspace sync [--dry-run]"
      fi
      ;;
    pull) pull_files "$@" ;;
    dry-run) sync_files true ;;
    run) run_remote "$@" ;;
    shell) open_shell "$@" ;;
    tmux) open_tmux "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"
